# secrets & per-user generated state — never commit
.env
.env.*
!.env.example
.state/
litellm/*
!litellm/.gitkeep
# LiteLLM's one hook (lowers max_tokens to a model's limit): part of the repository, in LiteLLM's config folder
!litellm/bn_hooks.py
backups/
# never commit credential documents
*bedrock-setup*.md
*credentials*
# python
__pycache__/
.pytest_cache/
*.pyc
tailscale/*
!tailscale/.gitkeep
tests/e2e/out/
tests/e2e/work/
# node (code/, code/web/: npm ci from their lockfiles; code/web builds into dist/ inside the image)
node_modules/
code/web/dist/
