{
  "name": "bedrock-now-code-web",
  "private": true,
  "version": "0.0.0",
  "description": "The Code page's browser UI (Preact + CodeMirror 6), built by esbuild into dist/. Every dependency is pinned exactly; npm ci checks each tarball against package-lock.json.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node dev/dev.mjs",
    "mock": "node dev/mock-server.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsc --noEmit -p . && node test/run.mjs",
    "e2e": "sh e2e/run.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0",
    "katex": "0.19.0",
    "mammoth": "1.13.0",
    "marked": "18.0.14",
    "mermaid": "12.0.0",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.4.299",
    "preact": "10.29.8",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "file:vendor/no-canvas",
    "@types/node": "24.19.0",
    "argparse": "file:vendor/no-argparse",
    "esbuild": "0.28.2",
    "jszip": "file:vendor/no-jszip",
    "typescript": "7.0.2",
    "ws": "8.22.0"
  },
  "overrides": {
    "@napi-rs/canvas": "$@napi-rs/canvas",
    "argparse": "$argparse",
    "jszip": "$jszip",
    "katex": "$katex",
    "lodash-es": "4.18.1"
  }
}
