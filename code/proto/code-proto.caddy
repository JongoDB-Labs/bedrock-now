# PROTOTYPE (code-page spike), imported by an e2e throwaway's Caddyfile only (code/proto/try.sh). The real site
# also asks the portal for the unlock and the Origin (?app=code) and routes /.bn/* to the portal; this one only
# needs the portal session.
http://{$CODE_HOST} {
	route {
		import local_request
		request_header -X-Bn-Code-Proxy
		import portal_auth
		reverse_proxy code-upstream:8095 {
			header_up -Cookie
			header_up -X-Portal-Proxy
			header_up -X-Portal-User
			header_up X-Bn-Code-Proxy {$CODE_PROXY_SECRET}
			header_down -Set-Cookie
			header_down -X-Frame-Options
			header_down X-Content-Type-Options nosniff
			header_down Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self' ws://{http.request.host}:* wss://{http.request.host}:*; img-src 'self' data: blob:; font-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors {$PORTAL_ORIGIN}"
		}
	}
}
