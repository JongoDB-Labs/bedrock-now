# Copied to .env and filled in by ./stack setup. Do not commit .env.
# ---- AWS (IAM user access key; only the litellm container receives these) ----
# On EC2 with an IAM role, setup can use the role instead: it writes AWS_AUTH=instance-role and removes the
# two key lines (docs/cloud-vm.md). ./stack rotate-aws --use-keys / --use-instance-role switches later.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1
# ---- Portal: http://PORTAL_HOST plus chat./admin./files. subdomains, on 127.0.0.1:PORTAL_PORT ----
# Blank = setup decides: bedrock-now.localhost (<project>.localhost for a second copy); port 80, else 8800.
PORTAL_HOST=
PORTAL_PORT=
# derived by setup from the two above (Caddy lets only this origin frame the apps)
PORTAL_ORIGIN=
# derived likewise: Chat's own origin (Open WebUI answers cross-origin requests from it and its remote one only)
CHAT_ORIGIN=
# The apps' host names (blank = chat./admin./files.PORTAL_HOST). Each needs its own name.
CHAT_HOST=
ADMIN_HOST=
FILES_HOST=
# ---- Host ports (127.0.0.1 only; setup moves them if taken) ----
LITELLM_PORT=4000
SHARED_MCP_PORT=8765
# ---- Budgets: USD per key, monthly budget (resets on the date shown by ./stack costs). Change them in the portal's
# Settings tab or with ./stack config set BUDGET_… (both apply them at once); edited here by hand: ./stack up ----
BUDGET_CLAUDE_CODE=200
BUDGET_OPENWEBUI=50
# model probe + ./stack test calls
BUDGET_SETUP=5
# the optional browser terminal's own key (claude-code-terminal; ./stack terminal enable creates it)
BUDGET_TERMINAL=50
# Optional: LiteLLM POSTs a JSON budget alert here when a key reaches 80% (soft budget) and 100% of its
# monthly budget (any URL that accepts a JSON POST, e.g. an n8n/Zapier/Make hook). Settings tab or ./stack config set.
ALERT_WEBHOOK_URL=
# Home, Chat, ./stack costs and the alert webhook warn at this share of a budget (50-99; blank = 80)
BUDGET_ALERT_PCT=
# ---- Prices: daily update from LiteLLM's public price list, cross-checked with the AWS Price List ----
# (public files from raw.githubusercontent.com and pricing.us-east-1.amazonaws.com, no credentials sent).
# false = always use catalog/prices.tsv.
PRICE_UPDATES=true
# Linux only, set by ./stack: the group the portal runs with, so it can write litellm/prices/ (and its
# .state/update-check/ folder).
PORTAL_GID=
# ---- Updates: the portal checks GitHub's public releases API once a day for a newer bedrock-now release ----
# (nothing about this install is sent; Home, ./stack status and claude-bedrock then say so). false = off.
UPDATE_CHECK=true
# true = Update / Rollback / Clean on Home also work from remote access; off by default. "Remote" means
# marked so by a remote-access Caddy block; an SSH tunnel or your own proxy to 127.0.0.1 counts as local.
REMOTE_ADMIN_ACTIONS=false
# ---- Remote access: the portal from your phone/laptop over HTTPS (./stack remote; docs/remote.md) ----
# off | tailscale | domain — set by ./stack remote enable/disable (setup asks once).
REMOTE_MODE=
# Your Tailscale login: remote requests that name another login are refused (blank = any, password only).
TAILSCALE_ALLOWED_LOGIN=
# Only until the sidecar has logged in (./stack removes it then); asked hidden by ./stack remote enable.
TS_AUTHKEY=
# Overrides (blank = defaults): Service base name (bedrock-now[-<project>]), the sidecar's machine name, its tag
TS_SERVICE=
TS_HOSTNAME=
TS_TAG=
# Own-domain mode only: a Cloudflare API token (Zone → DNS → Edit) for the DNS-01 certificate.
CLOUDFLARE_API_TOKEN=
# Written by ./stack remote: the tailnet's DNS name and the remote site's names and origin.
TS_TAILNET=
REMOTE_HOST=
REMOTE_CHAT_HOST=
REMOTE_ADMIN_HOST=
REMOTE_FILES_HOST=
REMOTE_ORIGIN=
# The small Docker network only the sidecar and Caddy share: a /24 to /29 without host bits (blank =
# 10.255.255.248/29); change it if ./stack says it collides. The sidecar's fixed address (its last host) is
# written by ./stack.
REMOTE_SUBNET=
REMOTE_SIDECAR_IP=
# ---- Update helper: one-click and automatic updates (./stack helper; docs/security.md#the-update-helper) ----
# Linux: the host uid the portal's request files belong to. Blank = 10102, or under rootless Docker the uid
# /etc/subuid maps it to; set it only if your setup maps uids differently.
HELPER_PORTAL_UID=
# 1 = the helper may also update a checkout that follows a branch (it installs whatever the branch has now)
BEDROCK_NOW_HELPER_ALLOW_BRANCH=
# Automatic updates (needs the helper; ./stack helper auto on|off, or the switch on Home). on = a new release
# installs by itself at night, between AUTO_UPDATE_HOUR and three hours later (this computer's time), with a
# backup first; releases only, never a branch; a release that failed is not retried automatically. Blank = off.
AUTO_UPDATE=off
AUTO_UPDATE_HOUR=3
# Nightly backups by the update helper (on|off): backups/<time>-nightly/ in the three hours from BACKUP_HOUR (this
# computer's time; blank = 2); the newest BACKUP_KEEP (1-60; blank = 7) are kept. Settings → Updates & backups.
BACKUP_NIGHTLY=off
BACKUP_HOUR=
BACKUP_KEEP=
# true = ./stack update only checks out release tags whose signature git verify-tag accepts (docs/security.md#code-provenance)
UPDATE_REQUIRE_SIGNED_TAGS=
# ---- Privacy: store prompt/response text in LiteLLM logs? ----
LITELLM_STORE_PROMPTS=false
# ---- OpenRouter: other models next to Bedrock (blank key = off, Bedrock only; README › Optional: OpenRouter) ----
# With a key, prompts to "or/…" models go to openrouter.ai and the model's provider.
# Optional OpenRouter: paste a key from https://openrouter.ai/settings/keys after the =, then run ./stack openrouter apply
OPENROUTER_API_KEY=
# which OpenRouter models to offer: all | free | paid | comma list of ids (blank = all; an account without
# credits gets free when the key is checked by setup or ./stack openrouter set/apply)
OPENROUTER_MODELS=
# safety cap on how many are rendered (blank = 1000; the newest are kept)
OPENROUTER_MAX_MODELS=
# true = also offer the "~vendor/…-latest" alias entries with all/free/paid
OPENROUTER_INCLUDE_ALIASES=
# ---- Speech-to-text for the microphone and voice calls (docs/voice.md) ----
# bedrock = Mistral Voxtral on Bedrock (no key; audio stays in your AWS account) — setup turns it on by default
# when your AWS key can use Voxtral. openai|groq = outside Bedrock: your speech goes there (needs STT_API_KEY).
# blank = browser speech recognition, no Call. Set with ./stack stt set bedrock|openai|groq (or at setup);
# edited by hand, run ./stack up.
STT_PROVIDER=
# openai/groq only
STT_API_KEY=
# blank = the provider's default (bedrock: voxtral-small, or voxtral-mini; openai: gpt-4o-mini-transcribe;
# groq: whisper-large-v3-turbo)
STT_MODEL=
# ---- Optional: the browser terminal (README: Claude Code in the browser; docs/security.md#the-browser-terminal) ----
# true = a Terminal tab in the portal: Claude Code in a sandbox container. Set by ./stack terminal enable/disable.
TERMINAL_ENABLED=
# The only folder of this computer it sees (at /workspace); written by ./stack terminal enable [--workspace DIR].
TERMINAL_WORKSPACE=
# off = no internet from the terminal (only LiteLLM and the shared MCP server); then ./stack up
TERMINAL_EGRESS=
# true = the terminal also over remote access (./stack remote); off by default. Then ./stack up.
# (Switches here read true/1/yes/on and false/0/no/off.)
REMOTE_TERMINAL=false
# Overrides (blank = defaults): its host name (terminal.PORTAL_HOST), its memory limit (4g)
TERMINAL_HOST=
TERMINAL_MEM_LIMIT=
# Written by ./stack: your uid/gid (files in the workspace stay yours) and the terminal's remote name
TERMINAL_UID=
TERMINAL_GID=
REMOTE_TERMINAL_HOST=
# ---- Optional: the Code page (README: The Code page; docs/security.md#the-code-page) ----
# true = a Code tab in the portal: Claude Code with a chat, permission prompts and your files, in the terminal's
# sandbox (so only while the terminal is on). Set by ./stack code enable/disable; remote access with REMOTE_TERMINAL.
CODE_ENABLED=
# true = its mode picker also offers Bypass permissions (one session at a time, after a confirmation; docs/security.md
# "Bypass permissions"). Turning it on: only from this computer (Settings or ./stack config set). Blank = off.
CODE_ALLOW_BYPASS=
# Override (blank = code.PORTAL_HOST)
CODE_HOST=
# Its previews of dev servers in the sandbox over remote access too: true turns them on (blank = off: they would be
# same-site with your tailnet's or domain's other apps — docs/remote.md first). Own-domain mode: a name on a domain
# of its own for them (blank = preview.<REMOTE_HOST>), another site — then blank means on.
REMOTE_PREVIEW=
REMOTE_PREVIEW_DOMAIN=
# Written by ./stack: its remote name, the site of its previews of dev servers in the sandbox (from PORTAL_HOST:
# bedrock-now-preview.localhost) and their remote address (own: REMOTE_PREVIEW_DOMAIN is served)
REMOTE_CODE_HOST=
PREVIEW_DOMAIN=
REMOTE_PREVIEW_HOST=
REMOTE_PREVIEW_SITE=
# ---- Open WebUI admin ----
OPENWEBUI_ADMIN_EMAIL=
# How many days a portal sign-in lasts (1-90; blank = 30)
PORTAL_SESSION_DAYS=
# ---- Generated secrets (leave blank; setup generates) ----
# PORTAL_PASSWORD signs you in to the portal (all browser UIs). Change it in the portal's Settings tab, or with
# ./stack config set PORTAL_PASSWORD (edited here by hand: ./stack up). The portal gets only its hash:
PORTAL_PASSWORD=
PORTAL_PASSWORD_HASH=
PORTAL_SECRET=
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_UI_PASSWORD=
WEBUI_SECRET_KEY=
OPENWEBUI_ADMIN_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
SHARED_MCP_TOKEN=
# Caddy sends it to the portal with every request, so only requests through Caddy can claim remote access
PORTAL_PROXY_SECRET=
# ---- Generated by setup after the stack is up ----
LITELLM_KEY_CLAUDE_CODE=
LITELLM_KEY_OPENWEBUI=
LITELLM_KEY_SETUP=
OPENWEBUI_API_KEY=
# The browser terminal's key and the header secret only its Caddy and ttyd know (./stack terminal enable).
LITELLM_KEY_TERMINAL=
TERMINAL_PROXY_SECRET=
# The header secret only the main Caddy and the code container know (./stack code enable)
CODE_PROXY_SECRET=
# The header secret only the main Caddy and the terminal's gateway know: the Code page's previews (./stack code enable)
PREVIEW_PROXY_SECRET=
# true once setup created the LiteLLM database admin (login: OPENWEBUI_ADMIN_EMAIL / LITELLM_UI_PASSWORD)
LITELLM_DB_ADMIN_READY=
# LiteLLM UI login name shown on the portal's Home page (admin, then the admin email)
LITELLM_UI_USER=
# true once setup installed Open WebUI's cost filter (it is switched on only at that first install)
OWUI_COST_FILTER_INSTALLED=
# openai while speech-to-text is on (Open WebUI's engine; kept in step with STT_* by ./stack)
OWUI_STT_ENGINE=
# Bedrock speech-to-text: where Open WebUI sends audio (the stt container) and the Voxtral model (kept in step)
OWUI_STT_BASE_URL=
STT_BEDROCK_MODEL=
# ---- Pins: your own model choices (blank = automatic; setup keeps a pin while that model is enabled) ----
CHAT_DEFAULT_MODEL=
CHAT_TASK_MODEL=
CLAUDE_MODEL_OPUS=
CLAUDE_MODEL_SONNET=
CLAUDE_MODEL_HAIKU=
# models Chat's picker leaves out (comma list); the API and Claude Code can still use them
MODELS_HIDDEN=
# ---- Chosen by setup from the models your key can use ----
CLAUDE_BEDROCK_OPUS_MODEL=
CLAUDE_BEDROCK_SONNET_MODEL=
CLAUDE_BEDROCK_HAIKU_MODEL=
OWUI_EMBED_ENGINE=
OWUI_EMBED_MODEL=
OWUI_HYBRID_SEARCH=false
OWUI_RERANK_ENGINE=
OWUI_RERANK_MODEL=
OWUI_ENABLE_IMAGES=false
OWUI_IMAGE_MODEL=
OWUI_DEFAULT_MODEL=
OWUI_TASK_MODEL=
