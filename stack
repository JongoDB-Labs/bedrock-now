#!/usr/bin/env bash
# bedrock-now CLI. Run `./stack help`.
set -euo pipefail
STACK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export STACK_DIR
. "$STACK_DIR/lib/common.sh"
. "$STACK_DIR/lib/ports.sh"
. "$STACK_DIR/lib/portal.sh"
. "$STACK_DIR/lib/models.sh"
. "$STACK_DIR/lib/commands.sh"
. "$STACK_DIR/lib/guard.sh"
. "$STACK_DIR/lib/open.sh"
. "$STACK_DIR/lib/owui.sh"
. "$STACK_DIR/lib/prices.sh"
use_best_prices   # PRICES: the daily-updated price file while fresh, else catalog/prices.tsv

ASSUME_YES=0
args=()
for a in "$@"; do
  case "$a" in -y | --yes) ASSUME_YES=1 ;; *) args+=("$a") ;; esac
done
export ASSUME_YES
set -- ${args[@]+"${args[@]}"}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
# Every command that touches this checkout's Compose project first checks that no other checkout owns it
# (setup runs the same check itself, after it has settled the project name; status only warns, so you can
# still look; uninstall checks even without .env, lists what it deletes, and releases the project afterwards).
case "$cmd" in
  setup) cmd_setup "$@" ;;
  status) [ ! -f "$ENV_FILE" ] || guard_project --warn; cmd_status "$@" ;;
  uninstall) guard_uninstall; cmd_uninstall "$@"; release_project ;;
  down | logs | costs | models)   # stop or read: check, but don't claim the project
    [ ! -f "$ENV_FILE" ] || guard_project --no-claim
    "cmd_${cmd}" "$@" ;;
  up | test | backup | restore | update)
    [ ! -f "$ENV_FILE" ] || guard_project
    "cmd_${cmd}" "$@" ;;
  rotate-aws) [ ! -f "$ENV_FILE" ] || guard_project; cmd_rotate_aws "$@" ;;
  prices) [ ! -f "$ENV_FILE" ] || guard_project; cmd_prices "$@" ;;   # runs the portal image: claims, like up
  open) cmd_open "$@" ;;
  openrouter) [ ! -f "$ENV_FILE" ] || guard_project; cmd_openrouter "$@" ;;
  help | -h | --help) cmd_help ;;
  *) die "unknown command: $cmd (try ./stack help)" ;;
esac
