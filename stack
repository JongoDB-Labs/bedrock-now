#!/usr/bin/env bash
# bedrock-now CLI. Run `./stack help`.
set -euo pipefail
STACK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export STACK_DIR
. "$STACK_DIR/lib/common.sh"
. "$STACK_DIR/lib/ports.sh"
. "$STACK_DIR/lib/portal.sh"
. "$STACK_DIR/lib/models.sh"
. "$STACK_DIR/lib/commands.sh"
. "$STACK_DIR/lib/guard.sh"
. "$STACK_DIR/lib/open.sh"
. "$STACK_DIR/lib/owui.sh"
. "$STACK_DIR/lib/prices.sh"
use_best_prices   # PRICES: the daily-updated price file while fresh, else catalog/prices.tsv

ASSUME_YES=0
args=()
for a in "$@"; do
  case "$a" in -y | --yes) ASSUME_YES=1 ;; *) args+=("$a") ;; esac
done
export ASSUME_YES
set -- ${args[@]+"${args[@]}"}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
# For Home's record of a command run in a terminal (lib/lock.sh): the command and its first argument when that is a
# plain word ("code enable", "config set"), never a value
BEDROCK_NOW_JOB_CMD="$cmd"
case "${1:-}" in [a-z]*) case "$1" in *[!a-z-]*) ;; *) BEDROCK_NOW_JOB_CMD="$cmd $1" ;; esac ;; esac
# -h/--help anywhere after the command (no real value is ever that): that command's part of ./stack help, before
# any check or change (exit 0). `./stack stt set openai --help` must never store "--help" as a model.
want_help=0
for a in "$@"; do case "$a" in -h | --help) want_help=1 ;; esac; done
if [ "$want_help" = 1 ]; then
  case "$cmd" in
    help | -h | --help) ;;
    remote) remote_usage; exit 0 ;;
    terminal) terminal_usage; exit 0 ;;
    code) code_usage; exit 0 ;;
    *) cmd_help_for "$cmd" || die "unknown command: $cmd (try ./stack help)"; exit 0 ;;
  esac
fi
# Once per command: an exported AWS key that isn't .env's is ignored (setup / rotate-aws use it on purpose).
case "$cmd" in setup | rotate-aws | help | -h | --help) ;; *) [ ! -f "$ENV_FILE" ] || warn_shell_aws_ignored ;; esac
# Every command that touches this checkout's Compose project first checks that no other checkout owns it
# (setup runs the same check itself, after it has settled the project name; status only warns, so you can
# still look; uninstall checks even without .env, lists what it deletes, and releases the project afterwards).
# Commands that may write .env refresh the settings snapshot the portal shows when they end (lib/settings.sh).
case "$cmd" in
  setup | up | restore | update | rollback | rotate-aws | openrouter | stt | remote | helper | config | models | terminal | code) on_exit settings_snapshot_refresh ;;
esac
case "$cmd" in
  setup) cmd_setup "$@" ;;
  status) [ ! -f "$ENV_FILE" ] || guard_project --warn; cmd_status "$@" ;;
  uninstall) guard_uninstall; cmd_uninstall "$@"; release_project ;;
  down | logs | costs | models)   # stop or read: check, but don't claim the project
    [ ! -f "$ENV_FILE" ] || guard_project --no-claim
    "cmd_${cmd}" "$@" ;;
  up | test | backup | restore | update | clean | rollback)
    [ ! -f "$ENV_FILE" ] || guard_project
    "cmd_${cmd}" "$@" ;;
  rotate-aws) [ ! -f "$ENV_FILE" ] || guard_project; cmd_rotate_aws "$@" ;;
  prices) [ ! -f "$ENV_FILE" ] || guard_project; cmd_prices "$@" ;;   # runs the portal image: claims, like up
  helper) [ ! -f "$ENV_FILE" ] || guard_project --no-claim; cmd_helper "$@" ;;   # no Compose changes
  remote) [ ! -f "$ENV_FILE" ] || guard_project; cmd_remote "$@" ;;
  open) cmd_open "$@" ;;
  serve)   # runs up: claims, like up; --stop only ends the wake lock
    if [ "${1:-}" = --stop ]; then [ ! -f "$ENV_FILE" ] || guard_project --no-claim
    else [ ! -f "$ENV_FILE" ] || guard_project; fi
    cmd_serve "$@" ;;
  ssh-info) cmd_ssh_info "$@" ;;
  openrouter) [ ! -f "$ENV_FILE" ] || guard_project; cmd_openrouter "$@" ;;
  stt) [ ! -f "$ENV_FILE" ] || guard_project; cmd_stt "$@" ;;
  terminal) [ ! -f "$ENV_FILE" ] || guard_project; cmd_terminal "$@" ;;
  code) [ ! -f "$ENV_FILE" ] || guard_project; cmd_code "$@" ;;
  password) cmd_password "$@" ;;
  config) cmd_config "$@" ;;   # guards the project itself before a change (set, apply)
  restart) [ ! -f "$ENV_FILE" ] || guard_project; cmd_restart "$@" ;;
  help | -h | --help) cmd_help ;;
  *) die "unknown command: $cmd (try ./stack help)" ;;
esac
_BN_CMD_DONE=1   # the command ran to its end (lib/lock.sh: an exit before this, with status 0, was a signal)
