#!/usr/bin/env perl
# notty [--timeout SECS] CMD [ARGS...] — runs CMD in a new session, so it has no controlling terminal: nothing it
# runs can prompt on /dev/tty, even when tests/e2e/run.sh itself runs in a terminal (./stack asks there otherwise).
# INT/TERM/HUP are passed on to CMD's whole process group (they are blocked across the fork, so none is lost in
# between); with --timeout the group gets TERM after SECS seconds and KILL 10 seconds later if it is still there
# (exit 124). Otherwise exits with CMD's status (128+N when signal N ended it). Perl: on macOS and Linux alike.
use strict;
use warnings;
use POSIX qw(:signal_h);

my $timeout = 0;
if (@ARGV >= 2 && $ARGV[0] eq '--timeout') { shift @ARGV; $timeout = shift @ARGV; }
die "usage: notty [--timeout SECS] CMD [ARGS...]\n" unless @ARGV;
my $GRACE = 10;

my $set = POSIX::SigSet->new(SIGINT, SIGTERM, SIGHUP, SIGALRM);
my $old = POSIX::SigSet->new;
sigprocmask(SIG_BLOCK, $set, $old) or die "notty: sigprocmask: $!\n";

my $pid = fork();
die "notty: fork: $!\n" unless defined $pid;
if ($pid == 0) {
  $SIG{$_} = 'DEFAULT' for qw(INT TERM HUP ALRM);
  POSIX::setsid() or die "notty: setsid: $!\n";
  sigprocmask(SIG_SETMASK, $old) or die "notty: sigprocmask: $!\n";
  exec { $ARGV[0] } @ARGV or die "notty: cannot run $ARGV[0]: $!\n";
}

# The child may not have called setsid yet when a signal arrives: then its group does not exist, so fall back to it.
sub to_child { my $sig = shift; kill($sig, -$pid) or kill($sig, $pid); }
my $timed_out = 0;
for my $sig (qw(INT TERM HUP)) { $SIG{$sig} = sub { to_child($sig); }; }
$SIG{ALRM} = sub {
  if (!$timed_out) { $timed_out = 1; to_child('TERM'); alarm $GRACE; }
  else { to_child('KILL'); }
};
sigprocmask(SIG_SETMASK, $old) or die "notty: sigprocmask: $!\n";
alarm $timeout if $timeout > 0;

my $r;
do { $r = waitpid($pid, 0); } while ($r == -1 && $!{EINTR});
my $status = $?;
alarm 0;
if ($timed_out) { kill 'KILL', -$pid; exit 124; }   # whatever of the group outlived CMD
exit($status & 127 ? 128 + ($status & 127) : $status >> 8);
