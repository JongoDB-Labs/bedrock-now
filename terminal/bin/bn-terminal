#!/bin/bash
# The terminal container's start (compose.terminal.yaml): the MCP config for claude-bedrock, Claude Code's first-run
# theme screen done once, then ttyd on a UNIX socket. Each browser connection attaches to the same tmux session
# (bn-session).
set -euo pipefail
umask 077
# ttyd listens on no network: only on this socket (mode 700 by the umask, in a volume shared with the terminal's
# gateway alone, which runs as this user). The gateway passes requests to it only with the secret header that the
# main Caddy adds after the portal's check — that secret stays out of this container, and out of every command line.
sock=/run/bn-ttyd/ttyd.sock
rm -f "$sock"   # one left by the last run
conf="$HOME/.config/bedrock-now"
mkdir -p "$conf"
# The shared store and knowledge bases (shared-mcp) through the gateway: rewritten at every start, so a new
# SHARED_MCP_TOKEN reaches it.
if [ -n "${SHARED_MCP_TOKEN:-}" ] && [ -n "${BN_MCP_URL:-}" ]; then
  jq -n --arg url "$BN_MCP_URL" --arg auth "Bearer $SHARED_MCP_TOKEN" \
    '{mcpServers: {"bedrock-shared": {type: "http", url: $url, headers: {Authorization: $auth}}}}' > "$conf/mcp.json.tmp"
  mv "$conf/mcp.json.tmp" "$conf/mcp.json"
fi
# First start only: no theme picker (dark, like the terminal). Claude Code's other first-run question — whether
# you trust the files in /workspace — stays yours to answer.
[ -e "$HOME/.claude.json" ] || printf '{"hasCompletedOnboarding":true,"theme":"dark"}\n' > "$HOME/.claude.json"
# The Code page (./stack code enable: compose.code.yaml sets BN_CODE=1): bn-coded, its spawn server, on a socket in the
# code-socket volume, which only the code container shares (it connects; it never listens there). Restarted when it
# exits — anything in here can kill it. Not under this script's `set -e` (a killed bn-coded would end the loop with
# it), and detached twice, so tini (PID 1), not ttyd, is the loop's parent and reaps it. Without the MCP token: the
# Claude Code it starts reads it from mcp.json, like claude-bedrock.
if [ "${BN_CODE:-}" = 1 ]; then
  ( ( set +e; while :; do env -u SHARED_MCP_TOKEN node /usr/local/bin/bn-coded.mjs; sleep 2; done ) </dev/null & )
fi
# ttyd: -i on a path ending in .sock is a UNIX socket (no TCP port); -W lets keystrokes through; -O refuses a
# WebSocket whose Origin is not this host (another website cannot drive the terminal with your cookies); URL
# arguments stay off. --index: ttyd's page with a viewport for phones (Dockerfile). The DOM renderer draws crisply at
# any pixel ratio; with tmux's mouse on, Shift-drag (Option-drag on a Mac) still selects text for the clipboard.
# The MCP token is left out of the environment of the shells started here: a convenience, not a boundary —
# anything in the sandbox runs as the same user and can read it (/proc/1/environ, mcp.json); it only opens what the
# sandbox may use anyway.
exec env -u SHARED_MCP_TOKEN ttyd --interface "$sock" --writable --check-origin \
  --ping-interval 20 --index /usr/local/share/bedrock-now/ttyd.html \
  -t 'titleFixed=Terminal · bedrock-now' -t fontSize=14 -t disableLeaveAlert=true -t disableResizeOverlay=true \
  -t rendererType=dom -t macOptionClickForcesSelection=true \
  -t 'fontFamily=ui-monospace, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace' \
  -t 'theme={"background":"#111820","foreground":"#e4e9ee","cursor":"#73b6cd","cursorAccent":"#111820","selectionBackground":"#2c4f5d"}' \
  bn-session
