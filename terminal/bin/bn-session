#!/bin/bash
# What ttyd runs for each browser connection: attach to the one tmux session, "claude" — or create it, with
# claude-bedrock in /workspace as its first window (a shell takes over once Claude Code exits). Closing the tab
# only detaches; Ctrl-b c opens another shell window.
#
# The pickers ("who answers": the Terminal tab, the Code page's terminal panel, the Chat tab) add words to the address
# (?arg=…, which ttyd's --url-arg hands over as arguments — never through a shell):
#   open TOOL TOKEN [DIR]   a window running TOOL (`subscriptions open TOOL`: its own sign-in first when it is not
#                           signed in), named after it, made the current one of "claude" — or that window, if it is
#                           there already
#   chat TOOL TOKEN [DIR]   the same window, shown alone in a session of its own grouped with "claude" (chat-TOOL…:
#                           the Chat tab's embedded tool; "claude"'s current window stays what it was)
# TOOL: bedrock (claude-bedrock), claude (claude-sub, your Claude plan), codex, gemini, copilot, cursor, grok, shell.
# TOKEN: a launch token, <iat>-<16 hex>-<32 hex> — the portal makes one only on your click (in its own page, the Code
# page's hand-off, or the terminal host's own "Open … here?" page) and lets no request to the terminal carry words
# without a valid one for exactly these words (portal/portal/answers.py, app.py launch_gate); here only its form is
# checked (this side cannot tell a real one: the gate did). Each acts once, and only within 10 minutes of when it was
# made (its <iat>: a reconnect — or the same address after the sandbox restarted — only attaches). DIR: /workspace
# or a folder below it, or one of the project folders of your computer (BN_CODE_ROOTS); default /workspace. Anything
# else — more words, other words, a folder elsewhere — is the plain attach above.
set -uo pipefail
S=claude
STATE="${BN_SESSION_STATE:-/tmp/bn-session}"
WS="${BN_CODE_WORKSPACE:-/workspace}"

plain() { exec tmux new-session -A -s "$S" -n claude -c "$WS" "claude-bedrock; exec bash"; }
ensure() { tmux has-session -t "=$S" 2>/dev/null || tmux new-session -d -s "$S" -n claude -c "$WS" "claude-bedrock; exec bash"; }

[ $# -ge 3 ] && [ $# -le 4 ] || plain
mode="$1" tool="$2" token="$3" dir="${4:-$WS}"
case "$mode" in open | chat) ;; *) plain ;; esac
case "$tool" in bedrock | claude | codex | gemini | copilot | cursor | grok | shell) ;; *) plain ;; esac
[[ $token =~ ^[0-9]{10}-[0-9a-f]{16}-[0-9a-f]{32}$ ]] || plain
# the folder: as it resolves, inside the workspace or a project folder of your computer
case "$dir" in /*) ;; *) plain ;; esac
real="$(cd -- "$dir" 2>/dev/null && pwd -P)" || plain
ok=0
case "$real/" in "$WS"/*) ok=1 ;; esac
if [ "$ok" = 0 ] && [ -n "${BN_CODE_ROOTS:-}" ]; then
  while IFS= read -r r; do
    case "$r" in /?*) case "$real/" in "$r"/*) ok=1 ;; esac ;; esac
  done < <(printf '%s' "$BN_CODE_ROOTS" | jq -r 'if type == "array" then .[] | strings else empty end' 2>/dev/null)
fi
[ "$ok" = 1 ] || plain

# the window: the tool's name, and — when it is not the workspace — the folder's (letters, digits, _ and - only: a "." or
# ":" would be read as a pane or a window in a tmux target) and a short hash of its path (two folders of one name
# stay two windows). Claude on your plan's is claude-sub (the first window, claude, is claude-bedrock's).
name="$tool"
[ "$tool" != claude ] || name=claude-sub
if [ "$real" != "$WS" ]; then
  name="$name-$(printf '%s' "${real##*/}" | LC_ALL=C tr -c 'A-Za-z0-9_-' '-' | cut -c1-20)-$(printf '%s' "$real" | sha256sum | cut -c1-6)"
fi
# a token acts once, and only while fresh (made at most 10 minutes ago, not ahead of this clock by more than 30 s)
fresh=0
iat="${token%%-*}" now="$(date +%s)"
if [ $((now - 10#$iat)) -le 600 ] && [ $((10#$iat - now)) -le 30 ]; then
  mkdir -p "$STATE" 2>/dev/null && chmod 700 "$STATE" 2>/dev/null && mkdir "$STATE/$token" 2>/dev/null && fresh=1
fi
ensure
if [ "$fresh" = 1 ]; then
  # (-S: the window of that name if there is one; the command is fixed words — TOOL is one of the list above — and the
  # image's own subscriptions by its full path: never one put in ~/.local/bin, which comes first on PATH; the folder
  # with its "#" doubled: tmux reads -c as a format)
  tmux new-window -S -d -t "=$S:" -n "$name" -c "${real//#/##}" "/usr/local/bin/subscriptions open $tool; exec bash" 2>/dev/null || plain
  # (one of your subscriptions' tools: its pane marked at once, as its launcher marks it — the Code page's @terminal
  # leaves it alone)
  case "$tool" in bedrock | shell) ;; *) tmux set-option -p -t "=$S:=$name" @bn-sub 1 2>/dev/null || true ;; esac
fi
if [ "$mode" = open ]; then
  [ "$fresh" = 0 ] || tmux select-window -t "=$S:=$name" 2>/dev/null || true
  exec tmux attach-session -t "=$S"
fi
view="chat-$name"
if ! tmux has-session -t "=$view" 2>/dev/null; then
  tmux new-session -d -t "=$S" -s "$view" 2>/dev/null || plain
  tmux set-option -t "=$view:" status off 2>/dev/null || true   # (a session option: "=NAME:" — "=NAME" alone is refused)
  fresh=1
fi
[ "$fresh" = 0 ] || tmux select-window -t "=$view:=$name" 2>/dev/null || true
exec tmux attach-session -t "=$view"
