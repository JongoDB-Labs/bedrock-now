#!/bin/bash
# grok in the bedrock-now sandbox: xAI's Grok Build CLI as xAI ships it (/usr/local/lib/bn-tools/grok: its npm package,
# pinned by its lockfile, the binary unpacked at build as its own postinstall would; terminal/Dockerfile's ai-tools
# stage). On your SuperGrok or X Subscription (or Grok Build's free tier): `grok login --device-auth` (a link and a
# short code for your browser), or `subscriptions login grok`; `grok logout`. It keeps the login in ~/.grok/auth.json
# (its own file, which bedrock-now never opens). Its self-update stays off (--no-auto-update): the image pins it.
set -euo pipefail
bin="${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/grok/grok"
[ -x "$bin" ] || { echo "grok: not in this sandbox (TERMINAL_AI_TOOLS in .env leaves it out: Settings › Claude Code › More)" >&2; exit 127; }
exec "$bin" --no-auto-update "$@"
