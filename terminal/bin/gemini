#!/bin/bash
# gemini in the bedrock-now sandbox: Google's Gemini CLI as Google ships it (/usr/local/lib/bn-tools/gemini, pinned by
# its lockfile; terminal/Dockerfile's ai-tools stage). Google AI Pro and Ultra stopped working in Gemini CLI on
# 2026-06-18; it signs in with Login with Google for an organisation's Gemini Code Assist Standard or Enterprise, or uses
# your own Gemini API key (GEMINI_API_KEY in this shell). Login with Google here prints a link and asks for the code
# your browser shows (NO_BROWSER=true: no browser can open in the sandbox). Its login stays in ~/.gemini (its own
# oauth_creds.json, which bedrock-now never opens); /auth signout in it signs out. Its auto-update is off in its system
# settings (/etc/gemini-cli/settings.json): the image pins its version.
set -euo pipefail
bin="${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/gemini/node_modules/.bin/gemini"
[ -x "$bin" ] || { echo "gemini: not in this sandbox (left out by TERMINAL_AI_TOOLS in .env — Settings › Claude Code › More — or its download failed when the image was built: ${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/SKIPPED)" >&2; exit 127; }
umask 077
# The stack's own variables are not this tool's — the gateway and the terminal's LiteLLM key, Bedrock's models and
# switches, the shared MCP server's token, AWS's: left out of its environment, as claude-sub leaves them out
for v in $(compgen -e); do
  case "$v" in
    ANTHROPIC_* | CLAUDE_CODE_* | CLAUDE_BEDROCK_* | CLAUDE_CONFIG_DIR | SHARED_MCP_TOKEN | BN_MCP_URL | AWS_*) unset "$v" ;;
  esac
done
# A tmux pane running it is marked as one of your subscriptions' tools (pane option @bn-sub): the Code page's @terminal
# leaves its screen alone, where a sign-in's code may show. A guard against an accidental read, not a boundary.
if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] && [ "${BN_SUB_NOMARK:-0}" != 1 ] && [ -x "${BN_TMUX_BIN:-/usr/bin/tmux}" ]; then
  "${BN_TMUX_BIN:-/usr/bin/tmux}" set-option -p -t "$TMUX_PANE" @bn-sub 1 >/dev/null 2>&1 || true
fi
export NO_BROWSER=true
exec "$bin" "$@"
