#!/bin/bash
# cursor-agent in the bedrock-now sandbox: Cursor's CLI as Cursor ships it (/usr/local/lib/bn-tools/cursor, the package
# its own installer downloads, pinned by version and the SHA-256 seen on 2026-10-23 — Cursor publishes no checksum;
# terminal/Dockerfile's ai-tools stage). On your Cursor plan: `cursor-agent login` prints a link to open in your
# browser and waits for it (NO_OPEN_BROWSER=1: no browser can open in the sandbox); `cursor-agent status`,
# `cursor-agent logout`. It keeps the login in ~/.config/cursor (its own file, which bedrock-now never opens). Its
# self-update stays off (--disable-auto-update): the image pins its version.
set -euo pipefail
bin="${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/cursor/cursor-agent"
[ -x "$bin" ] || { echo "cursor-agent: not in this sandbox (left out by TERMINAL_AI_TOOLS in .env — Settings › Claude Code › More — or its download failed when the image was built: ${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/SKIPPED)" >&2; exit 127; }
umask 077
# The stack's own variables are not this tool's — the gateway and the terminal's LiteLLM key, Bedrock's models and
# switches, the shared MCP server's token, AWS's: left out of its environment, as claude-sub leaves them out
for v in $(compgen -e); do
  case "$v" in
    ANTHROPIC_* | CLAUDE_CODE_* | CLAUDE_BEDROCK_* | CLAUDE_CONFIG_DIR | SHARED_MCP_TOKEN | BN_MCP_URL | AWS_*) unset "$v" ;;
  esac
done
# A tmux pane running it is marked as one of your subscriptions' tools (pane option @bn-sub): the Code page's @terminal
# leaves its screen alone, where a sign-in's code may show. A guard against an accidental read, not a boundary.
if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] && [ "${BN_SUB_NOMARK:-0}" != 1 ] && [ -x "${BN_TMUX_BIN:-/usr/bin/tmux}" ]; then
  "${BN_TMUX_BIN:-/usr/bin/tmux}" set-option -p -t "$TMUX_PANE" @bn-sub 1 >/dev/null 2>&1 || true
fi
export NO_OPEN_BROWSER=1
# no compiled-code cache in the writable home (Cursor's script would keep one in ~/.cache, and Node would run from it)
export NODE_DISABLE_COMPILE_CACHE=1
exec "$bin" --disable-auto-update "$@"
