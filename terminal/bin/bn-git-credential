#!/usr/bin/env node
// bn-git-credential: git's credential helper in the sandbox (bin/bn-coded.mjs names it for the Code page's remote
// operations; /etc/gitconfig names it for every other git here). It never keeps a credential: the code container
// (Settings › Claude Code › Git hosts, kept on the Code page) holds them, and answers one question at a time.
//   get    In a remote operation you started on the Code page (bn-coded sets BN_GIT_CRED_NONCE and gives that one git
//          process a socket as its fd 3, which only it and its children inherit): the question goes there, and nowhere
//          else. Otherwise — Claude's own git, or yours in the terminal — while you let Claude use a git host (off by
//          default), /tmp/bn-git/claude/cred.sock answers for that host; with nothing there: no answer (git goes on to
//          the next helper it knows, or says it could not read a username).
//   store / erase   nothing.
// Node built-ins only. Exits 0 whatever happens (a helper's failure is no answer to git).
import fs from 'node:fs';
import net from 'node:net';
import path from 'node:path';

const action = process.argv[2];
const FIELD = /^[\x21-\x7e]{1,1024}$/;
const done = (out = '') => { if (out) process.stdout.write(out); process.exit(0); };
if (action !== 'get') done();

// git's question: key=value lines, then a blank line or the end
let input = '';
try { input = fs.readFileSync(0, 'utf8').slice(0, 64 << 10); } catch { done(); }
const q = {};
for (const line of input.split('\n')) {
  if (!line) break;
  const i = line.indexOf('=');
  if (i > 0 && ['protocol', 'host', 'path', 'username'].includes(line.slice(0, i))) q[line.slice(0, i)] = line.slice(i + 1).slice(0, 2000);
}
if (q.protocol !== 'https' || !q.host) done();

// ask(sock, msg) -> the one answer line, or {} (60 s at most)
function ask(sock, msg) {
  return new Promise((resolve) => {
    let buf = '';
    const t = setTimeout(() => { sock.destroy(); resolve({}); }, 60000);
    const end = (v) => { clearTimeout(t); sock.destroy(); resolve(v); };
    sock.on('error', () => end({}));
    sock.on('close', () => end({}));
    sock.on('data', (d) => {
      buf += d.toString('utf8');
      if (buf.length > 16384) return end({});
      const i = buf.indexOf('\n');
      if (i < 0) return undefined;
      try { const v = JSON.parse(buf.slice(0, i)); return end(v && typeof v === 'object' ? v : {}); } catch { return end({}); }
    });
    sock.write(`${JSON.stringify(msg)}\n`);
  });
}

const nonce = process.env.BN_GIT_CRED_NONCE || '';
let sock = null;
const msg = { action: 'get', protocol: q.protocol, host: q.host, path: q.path || '', username: q.username || '' };
if (nonce) {
  // the Code page's operation: its fd 3 or nothing
  if (!/^[0-9a-f]{32}$/.test(nonce)) done();
  try { if (!fs.fstatSync(3).isSocket()) done(); } catch { done(); }
  sock = new net.Socket({ fd: 3, readable: true, writable: true });
  msg.nonce = nonce;
} else {
  const file = path.join(process.env.BN_GIT_TMP || '/tmp/bn-git', 'claude', 'cred.sock');
  try { if (!fs.statSync(file).isSocket()) done(); } catch { done(); }
  sock = net.connect(file);
}
const a = await ask(sock, msg);
if (FIELD.test(a.username || '') && FIELD.test(a.password || '')) done(`username=${a.username}\npassword=${a.password}\n`);
done();
