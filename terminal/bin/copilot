#!/bin/bash
# copilot in the bedrock-now sandbox: GitHub's Copilot CLI as GitHub ships it (/usr/local/lib/bn-tools/copilot/copilot,
# pinned and checked when the image was built; terminal/Dockerfile's ai-tools stage). On your Copilot plan (Free
# included): `copilot login` (in a container it uses GitHub's device flow: a one-time code for github.com/login/device),
# or `subscriptions login copilot`. With no keychain here it asks before keeping the login in ~/.copilot (its own file,
# which bedrock-now never opens); /logout in it signs out, /user shows who is signed in. A token you export in this
# shell (COPILOT_GITHUB_TOKEN, GH_TOKEN, GITHUB_TOKEN) comes first, as GitHub documents. Its self-update stays off
# (COPILOT_AUTO_UPDATE=false): the image pins its version, and an update would run a copy downloaded into your home;
# its own package (the code it runs) was unpacked into the image when it was built, not into your home.
set -euo pipefail
bin="${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/copilot/copilot"
[ -x "$bin" ] || { echo "copilot: not in this sandbox (left out by TERMINAL_AI_TOOLS in .env — Settings › Claude Code › More — or its download failed when the image was built: ${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/SKIPPED)" >&2; exit 127; }
umask 077
# The stack's own variables are not this tool's — the gateway and the terminal's LiteLLM key, Bedrock's models and
# switches, the shared MCP server's token, AWS's: left out of its environment, as claude-sub leaves them out
for v in $(compgen -e); do
  case "$v" in
    ANTHROPIC_* | CLAUDE_CODE_* | CLAUDE_BEDROCK_* | CLAUDE_CONFIG_DIR | SHARED_MCP_TOKEN | BN_MCP_URL | AWS_*) unset "$v" ;;
  esac
done
export COPILOT_AUTO_UPDATE=false
# its own package, unpacked into the image when it was built (never into the writable home, where it would run from)
export COPILOT_PKG_CACHE_HOME="${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/copilot/cache"
exec "$bin" "$@"
