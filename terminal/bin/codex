#!/bin/bash
# codex in the bedrock-now sandbox: OpenAI's Codex CLI as OpenAI ships it (/usr/local/lib/bn-tools/codex/codex, pinned
# and checked when the image was built; terminal/Dockerfile's ai-tools stage). On your ChatGPT plan: sign in with
# `codex login --device-auth` (a link and a one-time code for your browser — first turn on "device code login" in
# ChatGPT's Settings › Security), or `subscriptions login codex`. Its default sign-in waits on localhost:1455 inside
# the sandbox, which your browser cannot reach. Codex keeps the login in ~/.codex/auth.json (the terminal-home volume),
# its own file: bedrock-now never opens it. Nothing is changed or added here; this file only says where it is. Codex
# still looks for a newer version and may say one is out: it cannot replace itself here (the image is read-only), and
# ./stack update brings the version this stack pins.
set -euo pipefail
bin="${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/codex/codex"
[ -x "$bin" ] || { echo "codex: not in this sandbox (left out by TERMINAL_AI_TOOLS in .env — Settings › Claude Code › More — or its download failed when the image was built: ${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/SKIPPED)" >&2; exit 127; }
umask 077
# The stack's own variables are not this tool's — the gateway and the terminal's LiteLLM key, Bedrock's models and
# switches, the shared MCP server's token, AWS's: left out of its environment, as claude-sub leaves them out
for v in $(compgen -e); do
  case "$v" in
    ANTHROPIC_* | CLAUDE_CODE_* | CLAUDE_BEDROCK_* | CLAUDE_CONFIG_DIR | SHARED_MCP_TOKEN | BN_MCP_URL | AWS_*) unset "$v" ;;
  esac
done
# A tmux pane running it is marked as one of your subscriptions' tools (pane option @bn-sub): the Code page's @terminal
# leaves its screen alone, where a sign-in's code may show. A guard against an accidental read, not a boundary.
if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] && [ "${BN_SUB_NOMARK:-0}" != 1 ] && [ -x "${BN_TMUX_BIN:-/usr/bin/tmux}" ]; then
  "${BN_TMUX_BIN:-/usr/bin/tmux}" set-option -p -t "$TMUX_PANE" @bn-sub 1 >/dev/null 2>&1 || true
fi
exec "$bin" "$@"
