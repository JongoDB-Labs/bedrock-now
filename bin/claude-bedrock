#!/usr/bin/env bash
# Launch Claude Code against AWS Bedrock via this stack's LiteLLM proxy.
# Env vars are set for THIS process only — plain `claude` and ~/.claude are untouched.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do   # resolve symlinks portably (no readlink -f on older macOS)
  dir="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
STACK_DIR="$(cd -P "$(dirname "$src")/.." && pwd)"
export STACK_DIR
. "$STACK_DIR/lib/common.sh"
. "$STACK_DIR/lib/models.sh"   # price_label / key_info / spend_text for the launch line
. "$STACK_DIR/lib/prices.sh"; use_best_prices   # daily-updated prices while fresh, else catalog/prices.tsv
. "$STACK_DIR/lib/session.sh"  # session id header + cost summary on exit
. "$STACK_DIR/lib/version.sh"  # "vX available" from the portal's cached release check (no network here)

# --help / --version: no cost line, no LiteLLM needed. --help adds a short header about the wrapper.
case "${1:-}" in
  -h | --help)
    opus="$(get_env CLAUDE_BEDROCK_OPUS_MODEL)"; port="$(get_env LITELLM_PORT)"
    if [ -n "$opus" ] && [ -n "$port" ]; then
      m="$opus (main); CLAUDE_BEDROCK_MODEL=<name> picks another one per session"
      p="LiteLLM on 127.0.0.1:$port, key 'claude-code' (monthly budget; ./stack costs)"
      c="billed by Bedrock per token; $opus: $(price_label "$opus")"
    else
      m="not set up yet — run $STACK_DIR/stack setup"; p="not set up yet — run $STACK_DIR/stack setup"
      c="billed by Bedrock per token; prices: $STACK_DIR/stack costs"
    fi
    cat <<EOT
claude-bedrock: Claude Code on AWS Bedrock via bedrock-now (plain \`claude\` is unchanged)
  Model    $m
  Proxy    $p
  Quiet    CLAUDE_BEDROCK_QUIET=1 hides the launch cost line and the session cost on exit
  Cost     $c
  Below    Claude Code's own help; every option works with claude-bedrock

EOT
    command -v claude >/dev/null 2>&1 || die "Claude Code (claude) is not installed"
    restore_caller_locale; exec claude "$@" ;;
  -v | --version)
    command -v claude >/dev/null 2>&1 || die "Claude Code (claude) is not installed"
    restore_caller_locale; exec claude "$@" ;;
esac

[ -f "$ENV_FILE" ] || die "stack not set up — run $STACK_DIR/stack setup"
command -v claude >/dev/null 2>&1 || die "Claude Code (claude) is not installed"
port="$(get_env LITELLM_PORT)"
curl -fsS -m 3 -o /dev/null "http://127.0.0.1:$port/health/liveliness" ||
  die "LiteLLM is not running on 127.0.0.1:$port — run: $STACK_DIR/stack up"
opus="$(get_env CLAUDE_BEDROCK_OPUS_MODEL)"
[ -n "$opus" ] || die "no Claude model enabled for your AWS key — re-run $STACK_DIR/stack setup"
key="$(get_env LITELLM_KEY_CLAUDE_CODE)"
[ -n "$key" ] || die "no LiteLLM key for Claude Code in $ENV_FILE — re-run $STACK_DIR/stack setup"

unset ANTHROPIC_API_KEY CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY
export ANTHROPIC_BASE_URL="http://127.0.0.1:$port"
export ANTHROPIC_AUTH_TOKEN="$key"
export ANTHROPIC_MODEL="${CLAUDE_BEDROCK_MODEL:-$opus}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$opus"
ANTHROPIC_DEFAULT_SONNET_MODEL="$(get_env CLAUDE_BEDROCK_SONNET_MODEL)"
ANTHROPIC_DEFAULT_HAIKU_MODEL="$(get_env CLAUDE_BEDROCK_HAIKU_MODEL)"
export ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL
export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1   # Bedrock rejects Anthropic beta headers
export ENABLE_TOOL_SEARCH=true
# No telemetry, error reporting or update checks from Bedrock sessions; plain `claude` is unaffected.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# One cost line on stderr (CLAUDE_BEDROCK_QUIET=1 hides it). Spend comes from LiteLLM with this key;
# if that takes >2s or fails, the spend part is left out rather than delaying the launch.
if [ "${CLAUDE_BEDROCK_QUIET:-0}" != 1 ]; then
  line="bedrock · $ANTHROPIC_MODEL ($(price_label "$ANTHROPIC_MODEL"))"
  if info="$(key_info "$key" 2 1)" && spent="$(printf '%s' "$info" | spend_text)"; then
    line="$line · spent $spent this period"
    if bw="$(printf '%s' "$info" | budget_warning)"; then line="$line · $bw"; fi
  fi
  # LiteLLM still bills the prices it started with (files only, no network)
  if prices_pending; then line="$line · new prices pending — run ./stack up"; fi
  if upd="$(update_available)"; then line="$line · $upd available (./stack update)"; fi
  printf '%s\n' "$line" >&2
fi

# Sessions get the shared MCP server. Subcommands (`claude-bedrock mcp list`, `doctor`, …) reject
# --mcp-config, so it is added only when $1 is empty, an option, or not a subcommand. The subcommand
# list is parsed from `claude --help` on every launch (falls back to the 2.1.296 list).
# Known gap: options before a subcommand (`claude-bedrock --debug mcp list`) still get --mcp-config
# and fail; put options after the subcommand, or run plain `claude` for management commands.
subcmds="$(claude --help 2>/dev/null </dev/null | claude_subcommands || true)"
[ -n "$subcmds" ] || subcmds="agents attach auth auto-mode config doctor gateway import install logs mcp
  migrate-installer plugin plugins purge respawn rm setup-token stop kill ultrareview update upgrade"
mcp_args=()
add_mcp=1
case "${1:-}" in
  '' | -*) ;;
  *) for c in $subcmds; do [ "$c" = "$1" ] && { add_mcp=0; break; }; done ;;
esac
[ "$add_mcp" = 1 ] && [ -f "$STATE_DIR/mcp.json" ] && mcp_args=(--mcp-config "$STATE_DIR/mcp.json")

# Every request of this run carries a session id, so its cost can be looked up on exit (and found in
# LiteLLM UI › Logs). Your own ANTHROPIC_CUSTOM_HEADERS are kept.
session_id="$(session_new_id)"
ANTHROPIC_CUSTOM_HEADERS="$(session_headers "$session_id" "${ANTHROPIC_CUSTOM_HEADERS:-}")"
export ANTHROPIC_CUSTOM_HEADERS

restore_caller_locale   # Claude Code and its shell tools get the user's locale, not our C locale
# The session summary is for people: it is printed when stderr is a terminal (CLAUDE_BEDROCK_SUMMARY=1 forces
# it, e.g. for a script that wants it on stderr). Subcommands and CLAUDE_BEDROCK_QUIET=1 never get one.
# Without a summary the process is handed straight to claude, exactly as before.
want_summary=0
if [ "$add_mcp" = 1 ] && [ "${CLAUDE_BEDROCK_QUIET:-0}" != 1 ]; then
  if [ -t 2 ] || [ "${CLAUDE_BEDROCK_SUMMARY:-0}" = 1 ]; then want_summary=1; fi
fi
[ "$want_summary" = 1 ] || exec claude "$@" ${mcp_args[@]+"${mcp_args[@]}"}

# claude runs as an ordinary FOREGROUND child: same terminal, same process group, so Ctrl-C / Ctrl-Z / a closed
# terminal reach it directly, as with `exec`. The ':' traps only keep this wrapper alive until claude exits
# (a trapped signal is reset to its default in the child; `trap ''` would be inherited, so it is not used).
trap ':' INT QUIT TERM
trap 'exit 129' HUP
if claude "$@" ${mcp_args[@]+"${mcp_args[@]}"}; then rc=0; else rc=$?; fi
t_exit="$(date +%s)"
trap 'exit "$rc"' INT QUIT TERM HUP   # Ctrl-C while the summary is fetched: just leave

export LC_ALL=C   # number formatting in the summary (claude has already exited)
if [ -t 2 ]; then
  trap 'printf "\n" >&2; exit "$rc"' INT QUIT TERM HUP
  printf 'session: tallying cost…' >&2
  summary="$(session_summary "$session_id" "$t_exit")"
  printf '\r\033[K%s\n' "$summary" >&2
else
  session_summary "$session_id" "$t_exit" >&2
fi
# claude was killed by INT or TERM: die of the same signal, so callers (shells, `timeout`, CI) see it.
case "$rc" in
  130 | 143) trap - INT TERM; kill -s "$([ "$rc" = 130 ] && echo INT || echo TERM)" "$$"; sleep 1 ;;
esac
exit "$rc"
