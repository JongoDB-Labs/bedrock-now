#!/usr/bin/env bash
# Launch Claude Code against AWS Bedrock via this stack's LiteLLM proxy.
# Env vars are set for THIS process only — plain `claude` and ~/.claude are untouched. Claude Code runs with its own
# config folder, ~/.claude-bedrock: none of your ~/.claude plugins, hooks or MCP servers, which Bedrock bills per token
# in every request (CLAUDE_BEDROCK_USE_MY_CONFIG=1 loads them anyway; lib/claude_config.sh).
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do   # resolve symlinks portably (no readlink -f on older macOS)
  dir="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
STACK_DIR="$(cd -P "$(dirname "$src")/.." && pwd)"
export STACK_DIR
. "$STACK_DIR/lib/common.sh"
. "$STACK_DIR/lib/models.sh"   # price_label / key_info / spend_text for the launch line
. "$STACK_DIR/lib/prices.sh"; use_best_prices   # daily-updated prices while fresh, else catalog/prices.tsv
. "$STACK_DIR/lib/session.sh"  # session id header + cost summary on exit
. "$STACK_DIR/lib/version.sh"  # "vX available" from the portal's cached release check (no network here)
. "$STACK_DIR/lib/claude_config.sh"  # its own CLAUDE_CONFIG_DIR (lean) and the --resume hint on exit
. "$STACK_DIR/lib/code_models.sh"    # the models it may run (litellm/code-models.tsv): --models, --model, /model

# _cb_model NAME WHERE -> the full id NAME means among the models of litellm/code-models.tsv (an id, a name, an
# OpenRouter id without or/, opus/sonnet/haiku: that slot's model), [1m] kept; dies naming the choices when there is
# none. Without the file (./stack up writes it) Claude Code's aliases still become ids (cb_model_id) and nothing else
# is checked.
_cb_model() {
  local want="$1" base suffix='' id
  [ -r "$(code_models_file)" ] || { cb_model_id "$want"; return 0; }
  case "$want" in *'[1m]' | *'[1M]') suffix="${want#"${want%????}"}"; base="${want%????}" ;; *) base="$want" ;; esac
  id="$(code_model_resolve "$base")"
  [ -n "$id" ] || die "unknown model '$want' ($2) — claude-bedrock --models lists them: $(_code_rows | awk -F'\t' '$11 == 1 { printf "%s%s", (n++ ? ", " : ""), $1; if (n == 6) { printf ", …"; exit } }')"
  printf '%s%s\n' "$id" "$suffix"
}

# _cb_price ID -> "$0.72 in / $0.72 out per 1M tokens", "free ($0, OpenRouter)" … from litellm/code-models.tsv, else
# the catalog's price_label
_cb_price() {
  local row; row="$(code_model_row "${1%\[1[mM]\]}")"
  [ -n "$row" ] || { price_label "$1"; return 0; }
  printf '%s\n' "$row" | awk -F'\t' 'function m(v,  s) { s = sprintf("%.4f", v); while (s ~ /\.[0-9][0-9][0-9]+$/ && s ~ /0$/) s = substr(s, 1, length(s) - 1); return "$" s }
    { if ($9 == 1) print "free ($0, " $3 ")"; else if ($5 == "-" || $6 == "-") print "price unknown"; else printf "%s in / %s out per 1M tokens\n", m($5), m($6) }'
}

# --help / --version / --models: no cost line, no LiteLLM needed. --help adds a short header about the wrapper.
case "${1:-}" in
  --models)
    [ -f "$ENV_FILE" ] || die "stack not set up — run $STACK_DIR/stack setup"
    [ -r "$(code_models_file)" ] || die "no model list yet — run $STACK_DIR/stack up (it writes $(code_models_file))"
    if [ "${2:-}" = all ]; then printf 'Every enabled chat model (* = the default for new sessions):\n'
    else printf 'The models of Settings › Claude Code › Models (* = the default for new sessions; --models all: every enabled one):\n'; fi
    code_models_table "" "${2:-}"
    printf '\nclaude-bedrock --model <id or name> starts on one; /model in a session switches (by full id: an alias lets Claude Code\n'
    printf 'pick the model itself). Only models that "work" can use tools — read, edit and run things; prices as LiteLLM bills them.\n'
    exit 0 ;;
  -h | --help)
    opus="$(get_env CLAUDE_BEDROCK_OPUS_MODEL)"; port="$(get_env LITELLM_PORT)"
    def="$(code_models_default)"; def="${def:-$opus}"
    if [ -n "$opus" ] && [ -n "$port" ]; then
      m="$def (default); --model <id or name> or CLAUDE_BEDROCK_MODEL=<name> picks another, claude-bedrock --models lists them"
      p="LiteLLM on 127.0.0.1:$port, key 'claude-code' (monthly budget; ./stack costs)"
      c="billed per token by Bedrock (OpenRouter's models: by OpenRouter, free ones \$0); $def: $(_cb_price "$def")"
    else
      m="not set up yet — run $STACK_DIR/stack setup"; p="not set up yet — run $STACK_DIR/stack setup"
      c="billed by Bedrock per token; prices: $STACK_DIR/stack costs"
    fi
    if claude_config_resolve; then g="$(claude_config_help)"; else g="$CB_CONFIG_ERR"; fi
    if claude_config_resolve 2>/dev/null && claude_auto_mode_off; then
      a="off (as in the browser terminal and the Code page); CLAUDE_BEDROCK_AUTO_MODE=1 leaves it to Claude Code"
    elif [ "${CLAUDE_BEDROCK_AUTO_MODE:-0}" = 1 ]; then a="left to Claude Code (CLAUDE_BEDROCK_AUTO_MODE=1); its reviewer runs on Sonnet 5.5 (~\$0.13 per 5 minutes in use)"
    else a="left to Claude Code and your settings (your own config folder)"; fi
    cat <<EOT
claude-bedrock: Claude Code on AWS Bedrock via bedrock-now (plain \`claude\` is unchanged)
  Model    $m
  Proxy    $p
  Config   $g
  Auto     auto mode $a
  Quiet    CLAUDE_BEDROCK_QUIET=1 hides the launch cost line and the session cost on exit
  Cost     $c
  Below    Claude Code's own help; every option works with claude-bedrock

EOT
    command -v claude >/dev/null 2>&1 || die "Claude Code (claude) is not installed"
    restore_caller_locale; exec claude "$@" ;;
  -v | --version)
    command -v claude >/dev/null 2>&1 || die "Claude Code (claude) is not installed"
    restore_caller_locale; exec claude "$@" ;;
esac

[ -f "$ENV_FILE" ] || die "stack not set up — run $STACK_DIR/stack setup"
command -v claude >/dev/null 2>&1 || die "Claude Code (claude) is not installed"
port="$(get_env LITELLM_PORT)"
curl -fsS -m 3 -o /dev/null "http://127.0.0.1:$port/health/liveliness" ||
  die "LiteLLM is not running on 127.0.0.1:$port — run: $STACK_DIR/stack up"
opus="$(get_env CLAUDE_BEDROCK_OPUS_MODEL)"
[ -n "$opus" ] || die "no Claude model enabled for your AWS key — re-run $STACK_DIR/stack setup"
key="$(get_env LITELLM_KEY_CLAUDE_CODE)"
[ -n "$key" ] || die "no LiteLLM key for Claude Code in $ENV_FILE — re-run $STACK_DIR/stack setup"

# Claude Code's config folder: its own lean one (created 700), unless CLAUDE_BEDROCK_USE_MY_CONFIG=1. Subcommands get
# it too, so `claude-bedrock mcp add …` / `plugin install …` manage that folder. A CLAUDE_CONFIG_DIR you exported for
# your everyday claude is not used in lean mode (precedence: lib/claude_config.sh).
claude_config_resolve || die "$CB_CONFIG_ERR"
claude_config_prepare || die "$CB_CONFIG_ERR"   # created 700; an existing one must be yours and not group/other-writable
[ "$CB_OPT_IN" = 1 ] || export CLAUDE_CONFIG_DIR="$CB_CONFIG_DIR"

unset ANTHROPIC_API_KEY CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY
export ANTHROPIC_BASE_URL="http://127.0.0.1:$port"
export ANTHROPIC_AUTH_TOKEN="$key"
# The model, by its full id: --model of yours, else CLAUDE_BEDROCK_MODEL, else the default of Settings › Claude Code ›
# Models (CODE_DEFAULT_MODEL; blank: the main model). Any model of litellm/code-models.tsv, by id or name (_cb_model);
# given one of Claude Code's aliases (haiku, sonnet, opus) Claude Code picks the model itself — with "haiku" it plans on
# Sonnet in Plan mode — so an alias becomes its slot's id. --model is rewritten to that id (up to a `--` of yours).
def="$(code_models_default)"
ANTHROPIC_MODEL="$(_cb_model "${CLAUDE_BEDROCK_MODEL:-${def:-$opus}}" "${CLAUDE_BEDROCK_MODEL:+CLAUDE_BEDROCK_MODEL}${CLAUDE_BEDROCK_MODEL:-the default model}")"
cb_args=(); want=''; i=0
for a in "$@"; do
  i=$((i + 1))
  if [ "$want" = next ]; then a="$(_cb_model "$a" "--model")"; ANTHROPIC_MODEL="$a"; want=done
  elif [ "$want" != stop ]; then
    case "$a" in
      --) want=stop ;;
      --model) want=next ;;
      --model=*) a="--model=$(_cb_model "${a#--model=}" "--model")"; ANTHROPIC_MODEL="${a#--model=}" ;;
    esac
  fi
  cb_args+=("$a")
done
set -- ${cb_args[@]+"${cb_args[@]}"}
export ANTHROPIC_MODEL
export ANTHROPIC_DEFAULT_OPUS_MODEL="$opus"
ANTHROPIC_DEFAULT_SONNET_MODEL="$(get_env CLAUDE_BEDROCK_SONNET_MODEL)"
ANTHROPIC_DEFAULT_HAIKU_MODEL="$(get_env CLAUDE_BEDROCK_HAIKU_MODEL)"
export ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL
export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1   # Bedrock rejects Anthropic beta headers
# No ENABLE_TOOL_SEARCH: tool search (deferred MCP tools) needs a beta header, so with the betas off it changes
# nothing (Claude Code 2.1.301: every MCP tool inline with or without it). Hence the lean config folder above.
# No telemetry, error reporting or update checks from Bedrock sessions; plain `claude` is unaffected.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# One cost line on stderr (CLAUDE_BEDROCK_QUIET=1 hides it). Spend comes from LiteLLM with this key;
# if that takes >2s or fails, the spend part is left out rather than delaying the launch.
if [ "${CLAUDE_BEDROCK_QUIET:-0}" != 1 ]; then
  via=bedrock; case "$ANTHROPIC_MODEL" in or/*) via=openrouter ;; esac
  line="$via · $ANTHROPIC_MODEL ($(_cb_price "$ANTHROPIC_MODEL"))"
  case "$(code_model_row "$ANTHROPIC_MODEL" | cut -f10)" in
    chat-only) line="$line · chat only: it cannot use tools" ;;
    fails) line="$line · fails as Claude Code's model" ;;
    untested) line="$line · not tested with Claude Code" ;;
  esac
  if info="$(key_info "$key" 2 1)" && spent="$(printf '%s' "$info" | spend_text)"; then
    line="$line · spent $spent this period"
    if bw="$(printf '%s' "$info" | budget_warning)"; then line="$line · $bw"; fi
  fi
  # LiteLLM still bills the prices it started with (files only, no network)
  if prices_pending; then line="$line · new prices pending — run ./stack up"; fi
  if upd="$(update_available)"; then line="$line · $upd available (./stack update)"; fi
  printf '%s\n' "$line" >&2
  claude_config_line >&2    # which config folder: lean, or yours with a warning (subcommands too: `mcp add` changes it)
fi

# Sessions get the shared MCP server. Subcommands (`claude-bedrock mcp list`, `doctor`, …) reject
# --mcp-config, so it is added only when $1 is empty, an option, or not a subcommand. The subcommand
# list is parsed from `claude --help` on every launch (falls back to the 2.1.296 list).
# Known gap: options before a subcommand (`claude-bedrock --debug mcp list`) still get --mcp-config
# and fail; put options after the subcommand, or run plain `claude` for management commands.
subcmds="$(claude --help 2>/dev/null </dev/null | claude_subcommands || true)"
[ -n "$subcmds" ] || subcmds="agents attach auth auto-mode config doctor gateway import install logs mcp
  migrate-installer plugin plugins purge respawn rm setup-token stop kill ultrareview update upgrade"
mcp_args=()
add_mcp=1
case "${1:-}" in
  '' | -*) ;;
  *) for c in $subcmds; do [ "$c" = "$1" ] && { add_mcp=0; break; }; done ;;
esac
# It goes FIRST, as one `--mcp-config=FILE` argument: after your arguments, a `--` of yours turned it into prompt text;
# first but as two arguments, the variadic option would take your prompt for a second config file.
[ "$add_mcp" = 1 ] && [ -f "$STATE_DIR/mcp.json" ] && mcp_args=("--mcp-config=$STATE_DIR/mcp.json")
# Sessions get Claude Code's flag-tier settings (above every settings file; nothing of yours is written): its /model
# menu lists the models of Settings › Claude Code › Models by full id, name, price and how they work instead of its
# own lineup of aliases (lib/code_models.sh code_picker_json; your folder too), and auto mode is off in the lean
# folder's sessions (never in your own, CLAUDE_BEDROCK_USE_MY_CONFIG=1). A --settings of yours replaces it.
settings_args=()
if [ "$add_mcp" = 1 ]; then
  off=0; ! claude_auto_mode_off || off=1
  pj=''; [ ! -r "$(code_models_file)" ] || pj="$(code_picker_json "" "$off")"
  case "$pj" in
    *'"options":[{'*) settings_args=("--settings=$pj") ;;
    *) [ "$off" = 0 ] || settings_args=("$CB_AUTO_OFF_ARG") ;;
  esac
fi

# For people at a terminal starting a session: a new folder's first-run questions; once: how to bring a CLAUDE.md along.
if [ "${CLAUDE_BEDROCK_QUIET:-0}" != 1 ] && [ "$add_mcp" = 1 ] && [ -t 2 ]; then claude_config_notes >&2; fi

# Every request of this run carries a session id, so its cost can be looked up on exit (and found in
# LiteLLM UI › Logs). Your own ANTHROPIC_CUSTOM_HEADERS are kept.
session_id="$(session_new_id)"
ANTHROPIC_CUSTOM_HEADERS="$(session_headers "$session_id" "${ANTHROPIC_CUSTOM_HEADERS:-}")"
export ANTHROPIC_CUSTOM_HEADERS

restore_caller_locale   # Claude Code and its shell tools get the user's locale, not our C locale
# The session summary is for people: it is printed when stderr is a terminal (CLAUDE_BEDROCK_SUMMARY=1 forces
# it, e.g. for a script that wants it on stderr). Subcommands and CLAUDE_BEDROCK_QUIET=1 never get one.
# Without a summary the process is handed straight to claude, exactly as before.
want_summary=0
if [ "$add_mcp" = 1 ] && [ "${CLAUDE_BEDROCK_QUIET:-0}" != 1 ]; then
  if [ -t 2 ] || [ "${CLAUDE_BEDROCK_SUMMARY:-0}" = 1 ]; then want_summary=1; fi
fi
[ "$want_summary" = 1 ] || exec claude ${mcp_args[@]+"${mcp_args[@]}"} ${settings_args[@]+"${settings_args[@]}"} "$@"

# Interactive sessions end with `claude-bedrock --resume <id>`: Claude Code's own hint says plain `claude --resume`,
# which looks in ~/.claude and does not find a session kept in the lean folder (lib/claude_config.sh). A new session
# gets its id from the wrapper (--session-id), so the line names exactly this session; for --continue, the --resume
# picker and the like, the id is that of the one transcript of this folder written during the run, or the picker when
# several sessions wrote there. A marker file in the config folder (the transcripts' own clock) marks the start; it
# also shows when /clear or an in-session /resume moved on to another session (the line then says so).
marker=''; session_args=(); resume_id=''
claude_resume_plan "$@"
case "$CB_RESUME_KIND" in
  fresh) if resume_id="$(cb_new_uuid)"; then session_args=("--session-id=$resume_id"); else CB_RESUME_KIND=detect; fi ;;
  known) resume_id="$CB_RESUME_ID" ;;
esac
if [ "$CB_RESUME_KIND" != none ]; then
  marker="$(mktemp "$CB_CONFIG_DIR/.claude-bedrock-run.XXXXXX" 2>/dev/null)" ||
    marker="$(mktemp "${TMPDIR:-/tmp}/claude-bedrock.XXXXXX" 2>/dev/null)" || marker=''
fi

# claude runs as an ordinary FOREGROUND child: same terminal, same process group, so Ctrl-C / Ctrl-Z / a closed
# terminal reach it directly, as with `exec`. The ':' traps only keep this wrapper alive until claude exits
# (a trapped signal is reset to its default in the child; `trap ''` would be inherited, so it is not used).
trap ':' INT QUIT TERM
trap '[ -z "$marker" ] || rm -f "$marker"; exit 129' HUP
if claude ${session_args[@]+"${session_args[@]}"} ${mcp_args[@]+"${mcp_args[@]}"} ${settings_args[@]+"${settings_args[@]}"} "$@"; then rc=0; else rc=$?; fi
t_exit="$(date +%s)"
# Ctrl-C while the summary is fetched: just leave
trap '[ -z "$marker" ] || rm -f "$marker"; exit "$rc"' INT QUIT TERM HUP

export LC_ALL=C   # number formatting in the summary (claude has already exited)
# The resume line comes first: it is instant, the cost summary can take seconds (and Ctrl-C skips it).
resume=''
if [ "$CB_RESUME_KIND" != none ]; then
  if [ -n "$marker" ]; then
    resume="$(session_resume_choice "$CB_RESUME_KIND" "$resume_id" "$CB_CONFIG_DIR" "$marker")" || resume=''
    rm -f "$marker"; marker=''
  elif [ -n "$resume_id" ] && session_transcript_exists "$CB_CONFIG_DIR" "$resume_id"; then
    resume="$resume_id"   # no marker (folder not writable for it): the id the wrapper knows, without the /clear check
  fi
fi
case "$resume" in
  '') ;;
  pick) printf 'resume: %sclaude-bedrock --resume  (more than one session wrote in this folder meanwhile: pick yours)\n' \
          "$(claude_config_resume_prefix)" >&2 ;;
  *' others') printf 'resume: %sclaude-bedrock --resume %s  (after /clear or /resume: claude-bedrock --resume to pick)\n' \
          "$(claude_config_resume_prefix)" "${resume% others}" >&2 ;;
  *) printf 'resume: %sclaude-bedrock --resume %s\n' "$(claude_config_resume_prefix)" "$resume" >&2 ;;
esac
if [ -t 2 ]; then
  trap 'printf "\n" >&2; exit "$rc"' INT QUIT TERM HUP
  printf 'session: tallying cost…' >&2
  summary="$(session_summary "$session_id" "$t_exit")"
  printf '\r\033[K%s\n' "$summary" >&2
else
  session_summary "$session_id" "$t_exit" >&2
fi
# claude was killed by INT or TERM: die of the same signal, so callers (shells, `timeout`, CI) see it.
case "$rc" in
  130 | 143) trap - INT TERM; kill -s "$([ "$rc" = 130 ] && echo INT || echo TERM)" "$$"; sleep 1 ;;
esac
exit "$rc"
