# Remote site, Tailscale Services mode (./stack remote enable tailscale; imported by Caddyfile).
# The tailscale sidecar terminates HTTPS for svc:<name>[-chat|-admin|-files] and proxies plain HTTP to this
# listener, caddy:8081. It is NOT published on the host, and it answers only the sidecar's fixed address
# (REMOTE_SIDECAR_IP on the "remote" network of compose.tailscale.yaml, where only the sidecar and Caddy live);
# any other caller — another container, or a host process through the network's gateway — is cut off. Host
# stays <service>.<tailnet>.ts.net; the sidecar deletes client-sent Tailscale-User-* headers and adds
# Tailscale-User-Login for devices signed in as a user, which the portal checks against TAILSCALE_ALLOWED_LOGIN.
#   {$REMOTE_HOST}        portal     {$REMOTE_CHAT_HOST}   Open WebUI
#   {$REMOTE_ADMIN_HOST}  LiteLLM    {$REMOTE_FILES_HOST}  RustFS console
#   {$REMOTE_TERMINAL_HOST} the browser terminal — only with REMOTE_TERMINAL=true (lib/terminal.sh writes the name;
#                          otherwise it is terminal.remote.invalid, which matches nothing)
#   {$REMOTE_CODE_HOST}   the Code page — only with the Code page on and REMOTE_TERMINAL=true (lib/code.sh; otherwise
#                          code.remote.invalid)
# Same rules as the local site, plus X-Portal-Remote: 1 (any client copy deleted first): the portal then uses
# the remote origin and a host-only cookie per remote host (__Host-bn_session; app hosts get theirs via the
# hand-off).

(remote_request) {
	@not_sidecar not remote_ip {$REMOTE_SIDECAR_IP}/32
	abort @not_sidecar
	request_header -X-Portal-User
	request_header -X-Portal-Remote
	request_header -X-Portal-Proxy
	request_header X-Portal-Remote 1
	request_header X-Portal-Proxy {env.PORTAL_PROXY_SECRET}
}

# Towards the apps: no portal cookie or sign-in marker, no proxy secret; only the remote portal may frame them; and
# their cookies (set over plain http inside the stack, so without Secure) get Secure on this https site.
(remote_upstream) {
	header_up Cookie "__Host-bn_session=[^;]*;?\s*" ""
	header_up Cookie "__Host-bn_session_next=[^;]*;?\s*" ""
	header_up Cookie "__Host-bn_sso(_n|_pass)?=[^;]*;?\s*" ""
	header_up -X-Portal-Proxy
	header_down -X-Frame-Options
	header_down Content-Security-Policy "frame-ancestors {$REMOTE_ORIGIN}"
	header_down Set-Cookie "^(.*)$" "$1; Secure"
}

# The hand-off callback (portal/portal/app.py auth_callback): each app host gets its own host-only session cookie
# from a one-time token minted by the portal host. Answered by the portal, never by the app, and before the
# session check (the host has no cookie yet).
(handoff_callback) {
	@bn_callback path /.bn/callback
	reverse_proxy @bn_callback portal:8000 {
		rewrite /auth/callback?{query}
	}
}

http://{$REMOTE_HOST}:8081 {
	route {
		import remote_request
		import portal_routes
	}
}

http://{$REMOTE_CHAT_HOST}:8081 {
	route {
		import remote_request
		import handoff_callback
		import portal_auth
		reverse_proxy open-webui:8080 {
			import remote_upstream
		}
	}
}

http://{$REMOTE_ADMIN_HOST}:8081 {
	route {
		import remote_request
		import handoff_callback
		import portal_auth
		import app_sso
		reverse_proxy litellm:4000 {
			import remote_upstream
			import litellm_upstream
		}
	}
}

http://{$REMOTE_FILES_HOST}:8081 {
	route {
		import remote_request
		import handoff_callback
		import portal_auth
		import app_sso
		import files_inert {$REMOTE_ORIGIN}
		reverse_proxy rustfs:9001 {
			import remote_upstream
		}
	}
}

http://{$REMOTE_TERMINAL_HOST:terminal.remote.invalid}:8081 {
	route {
		import remote_request
		import handoff_callback
		import terminal_callback
		import terminal_unlock
		import terminal_auth
		reverse_proxy terminal-upstream:7681 {
			import terminal_upstream
			import terminal_page {$REMOTE_ORIGIN} https://{$REMOTE_CODE_HOST:code.remote.invalid}
		}
	}
}

http://{$REMOTE_CODE_HOST:code.remote.invalid}:8081 {
	route {
		import remote_request
		import handoff_callback
		import code_unlock
		import code_auth
		import code_portal
		reverse_proxy code-upstream:8095 {
			import code_upstream {$REMOTE_ORIGIN} {$REMOTE_TERMINAL_HOST:terminal.remote.invalid}
			import code_page {$REMOTE_ORIGIN} {$REMOTE_TERMINAL_HOST:terminal.remote.invalid}
		}
	}
}

http://:8081 {
	@not_sidecar not remote_ip {$REMOTE_SIDECAR_IP}/32
	abort @not_sidecar
	respond "unknown host" 404
}
