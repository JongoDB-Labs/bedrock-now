# bedrock-now reverse proxy: one login (the portal) in front of every browser UI.
# Values come from the environment ({$VAR}, set in compose.yaml from .env) — nothing secret lives here.
#   {$PORTAL_HOST}   portal: login + Home   (default bedrock-now.localhost)
#   {$CHAT_HOST}     Open WebUI             (default chat.PORTAL_HOST; logged in via the trusted X-Portal-User header)
#   {$ADMIN_HOST}    LiteLLM admin UI       (default admin.PORTAL_HOST; signed in by the portal: app_sso below)
#   {$FILES_HOST}    RustFS console         (default files.PORTAL_HOST; Host passed through unchanged: the console
#                                           signs S3 requests with it; signed in by the portal: app_sso below)
#   {$TERMINAL_HOST} the browser terminal   (only with ./stack terminal enable: terminal-on.caddy; default
#                                           terminal.PORTAL_HOST; a session AND a fresh password unlock)
#   {$CODE_HOST}     the Code page          (only with ./stack code enable: code-on.caddy; default code.PORTAL_HOST;
#                                           a session AND a fresh password unlock of its own)
# The apps must keep distinct host names: Open WebUI and LiteLLM both use a host-only cookie named "token".
# Every host first deletes any client-supplied X-Portal-User (and the rest of local_request), then asks the portal
# (forward_auth) whether the bn_session cookie is valid; only the portal's answer can set X-Portal-User.
# Directives inside `route` run in the order written (outside it, Caddy would run request_header AFTER
# forward_auth).
# The three apps may be framed by the portal ({$PORTAL_ORIGIN}, e.g. http://bedrock-now.localhost:8800) and
# nothing else; the portal itself refuses all framing (its own CSP: frame-ancestors 'none').
# Remote access (./stack remote, docs/remote.md) adds a second site from remote-{$REMOTE_MODE}.caddy, imported at
# the end. Only that site sets X-Portal-Remote: 1; every block here deletes a client-sent one.
{
	admin off
	# "off"; own-domain remote access (compose.domain.yaml) sets disable_redirects: its HTTPS site needs certificates
	auto_https {$CADDY_AUTO_HTTPS}
	persist_config off
	# Unprivileged listener inside the container; compose publishes it on 127.0.0.1:${PORTAL_PORT}.
	http_port 8080
	# The Tailscale remote listener (remote-tailscale.caddy) is never published and answers only the sidecar's
	# fixed address (REMOTE_SIDECAR_IP, compose.tailscale.yaml). Trusting the sidecar's X-Forwarded-Proto: https
	# keeps the apps' own redirects and links on https.
	servers :8081 {
		trusted_proxies static {$REMOTE_SIDECAR_IP}/32
	}
}

# Every local request: delete what only Caddy, the portal or the Tailscale sidecar may set, then add the shared
# secret that tells the portal this request came through Caddy (PORTAL_PROXY_SECRET; the apps never see it).
(local_request) {
	request_header -X-Portal-User
	request_header -X-Portal-Remote
	request_header -X-Portal-Proxy
	request_header -Tailscale-User-Login
	request_header -Tailscale-User-Name
	request_header -Tailscale-User-Profile-Pic
	request_header -Tailscale-Headers-Info
	request_header X-Portal-Proxy {env.PORTAL_PROXY_SECRET}
}

(portal_auth) {
	forward_auth portal:8000 {
		uri /auth/verify
		copy_headers X-Portal-User
	}
}

# The same-site guard, first thing on every app host — the portal, Chat, Admin, Files, the terminal and the Code page,
# here and on the remote sites (docs/security.md "The same-site guard"). Cookies with SameSite=Strict or Lax keep out
# requests from other *sites*, not from other hosts of the same site: every *.PORTAL_HOST here, every Service of a
# tailnet (ts.net is on the public suffix list: all of <tailnet>.ts.net is one site) and every name under your
# remote domain is one site — and so is the remote preview host (REMOTE_PREVIEW_HOST), which shows whatever the
# sandbox serves. Its script could otherwise send requests to these hosts that carry your cookies. Refused:
#   - anything whose Origin is a preview's (local: any host under PREVIEW_DOMAIN; remote: REMOTE_PREVIEW_HOST): a
#     preview's fetches, form posts and WebSockets — even from a browser that sends no Sec-Fetch-* headers;
#   - anything with Origin: null that is not same-origin: an opaque origin — a sandboxed frame or a data: page a preview
#     makes, whose requests say Sec-Fetch-Site: cross-site yet may carry the site's cookies (and a no-referrer form post
#     from a browser without Sec-Fetch-*). None of bedrock-now's own requests between its hosts send it;
#   - from any other host of the same site (Sec-Fetch-Site: same-site, which no page can set), everything but a page
#     load (Sec-Fetch-Mode navigate, GET/HEAD: a link, a frame, a redirect — the portal's frames, its hand-offs and
#     the Code page → terminal hand-off are all such) and a plain image, style sheet or script (no-cors GET: the
#     unlock and sign-in pages load the portal's logo and style sheet), whose answer no page can read. So no script on
#     a sibling host can read an app's answers (fetch, XHR, WebSocket) or change anything (POST, PUT, DELETE …).
# The stack's own requests between its hosts are only such page loads and assets; an app's own requests are
# same-origin. Requests without Sec-Fetch-Site (curl, ./stack, older browsers) and from other sites are not this
# guard's business: the session's SameSite=Strict, the portal's Origin checks and the apps' own handle those.
(not_from_preview) {
	@bn_from_preview {
		header Origin *.{$PREVIEW_DOMAIN:preview.invalid}*
		header Origin https://{$REMOTE_PREVIEW_HOST:preview.remote.invalid}
	}
	header @bn_from_preview X-Bn-Refused "same-site guard: from a preview"
	respond @bn_from_preview "refused: a request from a preview of the sandbox (bedrock-now's same-site guard, docs/security.md)" 403
	@bn_opaque {
		header Origin null
		not header Sec-Fetch-Site same-origin
	}
	header @bn_opaque X-Bn-Refused "same-site guard: an opaque origin"
	respond @bn_opaque "refused: a request from an opaque origin, such as a sandboxed frame (bedrock-now's same-site guard, docs/security.md)" 403
	@bn_same_site {
		header Sec-Fetch-Site same-site
		not {
			method GET HEAD
			header Sec-Fetch-Mode navigate
			header Sec-Fetch-Mode no-cors
		}
	}
	header @bn_same_site X-Bn-Refused "same-site guard: another host's script"
	respond @bn_same_site "refused: a script's request from another host of this site (bedrock-now's same-site guard, docs/security.md)" 403
}

# The portal's session cookie (Domain={$PORTAL_HOST}) is never handed to the apps behind it, nor are the markers of
# the automatic sign-in (app_sso below; they are only the portal's).
(drop_session_cookie) {
	header_up Cookie "bn_session=[^;]*;?\s*" ""
	header_up Cookie "bn_session_next=[^;]*;?\s*" ""
	header_up Cookie "bn_sso(_n|_pass)?=[^;]*;?\s*" ""
	header_up -X-Portal-Proxy
}

# Automatic sign-in to Admin and Files (portal/portal/appsso.py): the portal's check above sends a page load that
# needs the app's own session to /.bn/sso on the same host, which the portal answers (after that check, so only a
# signed-in browser gets here): it signs in to LiteLLM / RustFS with the sign-in it holds and hands this browser the
# app's session on this host only — LiteLLM's token cookie, or the RustFS console's credentials through a page that
# stores them. Nothing secret is ever in a URL. Imported by the admin and files site blocks here and in remote-*.caddy.
# Page loads also always come back through the check: LiteLLM's UI sends no Cache-Control, so a browser would take a
# page from its cache for hours without asking, after Sign out too (scripts and styles keep their caching).
(app_sso) {
	@bn_sso path /.bn/sso
	reverse_proxy @bn_sso portal:8000 {
		rewrite /auth/app-sso?{query}
	}
	@bn_page header Sec-Fetch-Mode navigate
	header @bn_page ?Cache-Control "no-cache"
}

# Towards LiteLLM: no `token` cookie. Its admin UI keeps its session there but sends it as Authorization itself;
# LiteLLM also takes the cookie as a credential on a few browser routes (MCP OAuth, BYOK sessions), which a page on
# another of the portal's hosts could drive with your cookies. The cost: those LiteLLM browser-redirect flows (unused
# here) need an Authorization header. Only that cookie goes (csrftoken and the like stay).
(litellm_upstream) {
	header_up Cookie "(^|;\s*)token=[^;]*" ""
}

# The files host also answers RustFS's S3 API (the console signs its requests for this name), so a stored file opened
# there would run on the console's origin, next to the credentials it keeps in localStorage. Everything but the console
# and the sign-in hand-off is inert there: a sandbox (no scripts, an origin of its own), framed only by the portal
# ({args[0]}), never content-sniffed. Downloads and the console's own requests are unaffected.
(files_inert) {
	@bn_object not path /rustfs/console /rustfs/console/* /.bn/*
	header @bn_object {
		Content-Security-Policy "sandbox; default-src 'none'; frame-ancestors {args[0]}"
		X-Content-Type-Options nosniff
		defer
	}
}

# Replaces whatever framing policy the app sends (LiteLLM: X-Frame-Options DENY + CSP frame-ancestors 'none';
# Open WebUI and RustFS: none) with "only the portal may frame this".
(frame_by_portal_only) {
	header_down -X-Frame-Options
	header_down Content-Security-Policy "frame-ancestors {$PORTAL_ORIGIN}"
}

# The portal paths reachable without a session: the login page and what it needs, and the installable web app's
# manifest, icons and service worker (browsers fetch those without the cookie). Every portal site block (the local
# one and the remote ones in remote-*.caddy, all through portal_routes) imports this one list, so they can never
# drift apart. The icons are named one by one (portal/portal/appicons.py FILES; tests/test_portal.sh keeps the two
# equal): no wildcard under /icons/.
(public_paths) {
	@public path /login /healthz /favicon.svg /favicon.ico /static/login.css /static/logo.svg /manifest.webmanifest /sw.js /icons/app-16.png /icons/app-32.png /icons/app-48.png /icons/app-192.png /icons/app-512.png /icons/app-1024.png /icons/app-maskable-192.png /icons/app-maskable-512.png /icons/app-monochrome-512.png /icons/app-touch-180.png
}

# The portal's routes, shared by the local site below and the remote site (remote-*.caddy).
(portal_routes) {
	import not_from_preview
	# Caddy's own check endpoint is internal; browsers never need it.
	respond /auth/verify 404
	# The login form is a password and a next= URL; a larger body is refused before it reaches the portal.
	request_body /login {
		max_size 16KB
	}
	# One-click Update/Rollback/Clean: a tiny JSON body (action + password).
	request_body /api/admin/* {
		max_size 4KB
	}
	# Settings: the changed values and the password (the portal refuses more than 12 KB itself).
	request_body /api/settings/* {
		max_size 16KB
	}
	# The public paths (snippet above) need no session; everything else does.
	import public_paths
	reverse_proxy @public portal:8000
	import portal_auth
	reverse_proxy portal:8000
}

http://{$PORTAL_HOST} {
	route {
		import local_request
		import portal_routes
	}
}

http://{$CHAT_HOST} {
	route {
		import local_request
		import not_from_preview
		import portal_auth
		reverse_proxy open-webui:8080 {
			import drop_session_cookie
			import frame_by_portal_only
		}
	}
}

http://{$ADMIN_HOST} {
	route {
		import local_request
		import not_from_preview
		import portal_auth
		import app_sso
		reverse_proxy litellm:4000 {
			import drop_session_cookie
			import litellm_upstream
			# LiteLLM's CSP holds nothing but frame-ancestors 'none', so replacing it loses nothing else.
			import frame_by_portal_only
		}
	}
}

http://{$FILES_HOST} {
	route {
		import local_request
		import not_from_preview
		import portal_auth
		import app_sso
		import files_inert {$PORTAL_ORIGIN}
		reverse_proxy rustfs:9001 {
			import drop_session_cookie
			import frame_by_portal_only
		}
	}
}

# The browser terminal (./stack terminal; terminal-on.caddy and the remote sites). Its unlock form — the portal
# password typed again — posts to /.bn/unlock on the terminal host, answered by the portal before the check (it
# sets the host-only unlock cookie). Everything else needs the portal's yes for the terminal (?app=terminal, fixed
# here, so no request header can turn it into another app's check): a session, a fresh unlock, an Origin of the
# terminal host itself, and — for an address with the pickers' words (?arg=…) — a launch token made on your click. ttyd sits behind terminal-upstream:7681 (the terminal's gateway, compose.terminal.yaml).
(terminal_unlock) {
	request_body /.bn/unlock {
		max_size 16KB
	}
	@bn_unlock path /.bn/unlock
	reverse_proxy @bn_unlock portal:8000 {
		rewrite /auth/terminal-unlock
	}
	# (the "Open … here?" page's Open: the portal makes a launch token for the words it names — the only way an address
	# with the pickers' words gets past the check below without one made in the portal's own page)
	request_body /.bn/launch {
		max_size 16KB
	}
	@bn_launch path /.bn/launch
	reverse_proxy @bn_launch portal:8000 {
		rewrite /auth/terminal-launch
	}
}

# The Code page's terminal panel unlocks the terminal with the Code page's own unlock (one password for both): the
# code host's /.bn/terminal (code_portal) sends the browser here with a single-use, 60-second token for this host,
# which the portal redeems — before the check below, which then lets the browser in — into this host's unlock cookie.
(terminal_callback) {
	@bn_unlock_callback path /.bn/unlock-callback
	reverse_proxy @bn_unlock_callback portal:8000 {
		rewrite /auth/terminal-unlock-callback?{query}
	}
}

# (Any client-sent X-Bn-Terminal-* goes here, in a step of its own: within one header_up block Caddy deletes after
# it sets, which would take the secret header below away again.)
(terminal_auth) {
	request_header -X-Bn-Terminal-*
	forward_auth portal:8000 {
		uri /auth/verify?app=terminal
	}
}

# Towards ttyd: none of the browser's cookies or headers that only Caddy, the portal or the sidecar may set, and the
# terminal's secret header (X-Bn-Terminal-0<TERMINAL_PROXY_SECRET>): the terminal's gateway passes nothing to ttyd
# without it (and removes it), so only what passed the check above gets in.
(terminal_upstream) {
	header_up -Cookie
	header_up -X-Portal-Proxy
	header_up -X-Portal-User
	header_up X-Bn-Terminal-0{$TERMINAL_PROXY_SECRET} 1
}

# From ttyd — or from whatever listens on its socket instead (anything in the sandbox can): this Caddy sets the
# terminal host's policy, whoever answered. Only ttyd's own script runs (its hash; terminal/Dockerfile stops the build
# when ttyd's page changes: TTYD_PAGE_SCRIPT_SHA256, the same value), it talks only to this host, forms post only
# to the unlock, and only {args[0]} (the portal) may frame it. Headers that could plant or clear cookies (the
# portal's too), redirect, preload, widen a service worker, open CORS or send reports go. The unlock page and the
# unlock itself are the portal's answers (forward_auth, terminal_unlock), with the portal's own headers. The Code page
# ({args[1]}; a name that serves nothing while it is off) may frame it too: its terminal panel.
(terminal_page) {
	header_down -X-Frame-Options
	header_down -Set-Cookie
	header_down -Clear-Site-Data
	header_down -Refresh
	header_down -Link
	header_down -Location
	header_down -Service-Worker-Allowed
	header_down -Access-Control-*
	header_down -Content-Security-Policy-Report-Only
	header_down -Report-To
	header_down -Reporting-Endpoints
	header_down -NEL
	header_down X-Content-Type-Options nosniff
	header_down Content-Security-Policy "default-src 'none'; script-src 'sha256-qpCL1JTmm6ktW0DnjpSILM7GnS2fO8/e+XjSlYJuQzQ='; connect-src 'self' ws://{http.request.host}:* wss://{http.request.host}:*; img-src data: blob:; font-src data:; style-src 'unsafe-inline'; form-action {http.request.host}:*/.bn/unlock; base-uri 'none'; object-src 'none'; frame-ancestors {args[0]} {args[1]}"
}

# The Code page (./stack code; code-on.caddy and the remote sites): the same scheme as the terminal's. Its unlock form
# posts to /.bn/unlock on the code host, answered by the portal before the check (a host-only cookie of its own,
# bn_code). Everything else needs the portal's yes for the Code page (?app=code, fixed here): a session, a fresh
# unlock, and no Origin but the code host's own. The code container (code-upstream:8095, compose.code.yaml) answers
# only requests carrying CODE_PROXY_SECRET, added below after the check; client copies of the headers only this Caddy
# may set go first, in a step of their own.
(code_unlock) {
	request_body /.bn/unlock {
		max_size 16KB
	}
	@bn_code_unlock path /.bn/unlock
	reverse_proxy @bn_code_unlock portal:8000 {
		rewrite /auth/code-unlock
	}
}

(code_auth) {
	request_header -X-Bn-Code-Proxy
	request_header -X-Bn-Csp-Nonce
	request_header -X-Bn-Portal-Origin
	request_header -X-Bn-Terminal-Host
	request_header -X-Bn-Remote
	request_header -X-Bn-Artifact
	forward_auth portal:8000 {
		uri /auth/verify?app=code
	}
}

# After the check, the portal answers for the page what the code container must not hold: the models with this
# stack's prices (/.bn/models), your AI subscriptions' tools in the sandbox and what each says of its login
# (/.bn/answers), a session's spend from LiteLLM's logs (/.bn/spend; the master key stays in the portal) and the
# hand-off of this unlock to the terminal host for the page's terminal panel (/.bn/terminal: a redirect to that host's
# /.bn/unlock-callback, terminal_callback; ?open=TOOL: a window of that tool there, with a launch token the page's own
# POST /.bn/terminal-launch made — else the terminal asks "Open … here?"), a preview link for a port in the
# sandbox (/.bn/preview: locally its capability, from this unlock, caddy/preview-on.caddy; remotely a single-use
# hand-off to the preview host, remote_preview below) and the sandboxed artifact viewer's address (/.bn/artifact: its
# capability, from this unlock; caddy/artifact-on.caddy; local only). Any other /.bn/ path is nobody's.
(code_portal) {
	@bn_code_preview path /.bn/preview
	reverse_proxy @bn_code_preview portal:8000 {
		rewrite /auth/code-preview?{query}
	}
	@bn_code_artifact path /.bn/artifact
	reverse_proxy @bn_code_artifact portal:8000 {
		rewrite /auth/code-artifact?{query}
	}
	@bn_code_terminal path /.bn/terminal
	reverse_proxy @bn_code_terminal portal:8000 {
		rewrite /auth/code-terminal?{query}
	}
	# (the terminal panel's Open menu: a launch token, made only by the page's own POST — an address alone makes none)
	request_body /.bn/terminal-launch {
		max_size 4KB
	}
	@bn_code_terminal_launch path /.bn/terminal-launch
	reverse_proxy @bn_code_terminal_launch portal:8000 {
		rewrite /auth/code-terminal-launch
	}
	@bn_code_models path /.bn/models
	reverse_proxy @bn_code_models portal:8000 {
		rewrite /auth/code-models
	}
	@bn_code_spend path /.bn/spend
	reverse_proxy @bn_code_spend portal:8000 {
		rewrite /auth/code-spend?{query}
	}
	# (who answers: your AI subscriptions' tools in the sandbox, for its terminal panel's Open menu)
	@bn_code_answers path /.bn/answers
	reverse_proxy @bn_code_answers portal:8000 {
		rewrite /auth/code-answers
	}
	# (the Import sheet's requests to the computer: the portal checks the password and writes the helper's request)
	request_body /.bn/sessions {
		max_size 16KB
	}
	@bn_code_sessions path /.bn/sessions
	reverse_proxy @bn_code_sessions portal:8000 {
		rewrite /auth/code-sessions
	}
	respond /.bn/* 404
}

# Towards the code container: none of the browser's cookies or the headers only Caddy and the portal may set; the
# secret header; the per-request nonce the CSP below allows for <style> (the page reads it from a meta tag the
# backend adds); the portal origin that frames the page ({args[0]}: where its badge messages go), this site's
# terminal host ({args[1]}: its terminal panel) and whether this is a remote site ({args[2]}: 1 on remote-*.caddy's,
# 0 here; the Bypass permissions dialog says so).
(code_upstream) {
	header_up -Cookie
	header_up -X-Bn-Artifact
	header_up -X-Portal-Proxy
	header_up -X-Portal-User
	header_up X-Bn-Code-Proxy {$CODE_PROXY_SECRET}
	header_up X-Bn-Csp-Nonce {http.request.uuid}
	header_up X-Bn-Portal-Origin {args[0]}
	header_up X-Bn-Terminal-Host {args[1]}
	header_up X-Bn-Remote {args[2]}
}

# From the code container — or whatever answers in its place: this Caddy sets the code host's policy. Scripts and
# styles only from the code host itself (styles also with this request's nonce), connections only to it, images also
# data:/blob:, audio and video only from blob: (the file previews play workspace files from bytes the page fetched),
# workers only from itself, frames only the terminal host ({args[1]}), itself (the terminal panel starts at
# /.bn/terminal, which redirects there) and the dev-server previews' and artifact viewer's hosts ({args[2]}:
# http://*.PREVIEW_DOMAIN on the portal's port here — those names resolve to this computer's loopback, and a framed
# page of sandbox content must not navigate its frame to another service there — https://REMOTE_PREVIEW_HOST on the
# remote sites; caddy/preview-on.caddy, artifact-on.caddy, remote_preview), no forms, no
# plugins, framed only by the portal ({args[0]}), and Trusted Types: no HTML-string sink can run at all, and the one
# policy allowed, bn-worker (code/web/src/preview/tt.ts), turns
# only the build's own worker paths into script URLs. The policy applies to the workers' own scripts too (Caddy sets
# it on every response). Headers that could plant or clear cookies, redirect, preload, widen a service worker, open
# CORS or send reports go.
(code_page) {
	header_down -X-Frame-Options
	header_down -Set-Cookie
	header_down -Clear-Site-Data
	header_down -Refresh
	header_down -Link
	header_down -Location
	header_down -Service-Worker-Allowed
	header_down -Access-Control-*
	header_down -Content-Security-Policy-Report-Only
	header_down -Report-To
	header_down -Reporting-Endpoints
	header_down -NEL
	header_down X-Content-Type-Options nosniff
	header_down Referrer-Policy same-origin
	header_down Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'nonce-{http.request.uuid}'; connect-src 'self' ws://{http.request.host}:* wss://{http.request.host}:*; img-src 'self' data: blob:; media-src blob:; font-src 'self'; worker-src 'self'; manifest-src 'self'; frame-src 'self' http://{args[1]}:{$PORTAL_PORT:80} https://{args[1]}:* {args[2]}; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors {args[0]}; require-trusted-types-for 'script'; trusted-types bn-worker"
}

# The Code page's previews of dev servers in the sandbox (README "Previews of dev servers"; docs/security.md "Previews of
# dev servers in the sandbox"): towards bn-preview in the sandbox (the terminal's gateway, terminal-upstream:7682),
# after the portal's check named the port (X-Bn-Preview-Port). Used by the local preview site (caddy/preview-on.caddy)
# and the remote one (remote_preview below). {args[0]}: who may frame a preview (the Code page and the portal of this
# site); {args[1]}: the previews' own hosts (a preview may frame its own and other previews).
(preview_upstream) {
	# towards bn-preview: none of what only Caddy, the portal or the sidecar may set, no bedrock-now cookie (a browser
	# sends none here locally: another site; remotely the preview host's own routing cookie; a preview's own bn_* go
	# too), no Referer (it may name the capability), nothing of your Tailscale identity; Host and Origin as the dev
	# server expects them for its own address (Vite's, Next's and webpack's host checks pass unchanged); the preview's
	# secret header, which the gateway requires before bn-preview and removes
	header_up -X-Portal-Proxy
	header_up -X-Portal-User
	header_up -X-Portal-Remote
	header_up -Tailscale-*
	header_up -Referer
	header_up Cookie "(^|;\s*)(__Host-)?bn_[^=;]*=[^;]*" ""
	header_up Cookie "^[;\s]+" ""
	header_up Host localhost:{http.request.header.X-Bn-Preview-Port}
	header_up Origin ".+" "http://localhost:{http.request.header.X-Bn-Preview-Port}"
	header_up X-Bn-Preview-0{$PREVIEW_PROXY_SECRET} 1
	# back: the app's own headers, but no cookie for the whole preview domain (Domain= dropped, in any spelling:
	# host-only), none with bedrock-now's names (the remote preview host's routing cookie stays the portal's: emptied),
	# no framing refusal of its own (the CSP below decides; bn-preview drops the app's frame-ancestors), nothing that
	# clears site data, widens a service worker or sends reports; no Referer to other origins (it would name the
	# capability) — same-origin keeps it, and with it the Origin of the app's own form posts (no-referrer makes browsers
	# send "Origin: null" for those); and a CSP added beside the app's own (both apply): only the Code page and the
	# portal ({args[0]}) may frame it, and it frames nothing on bedrock-now's local hosts (or this computer's localhost:
	# only https, the previews' own hosts, data: and blob:)
	header_down -X-Frame-Options
	header_down -Clear-Site-Data
	header_down -Service-Worker-Allowed
	header_down -Content-Security-Policy-Report-Only
	header_down -Report-To
	header_down -Reporting-Endpoints
	header_down -NEL
	header_down Set-Cookie "(?i);\s*domain\s*=[^;]*" ""
	header_down Set-Cookie "(?i)^\s*(__Host-|__Secure-)?bn_[^=]*=.*$" ""
	header_down Referrer-Policy same-origin
	header_down +Content-Security-Policy "frame-ancestors {args[0]}; frame-src 'self' https: data: blob: {args[1]}"
}

# The remote preview host (REMOTE_PREVIEW_HOST; remote-*.caddy, after remote_request and nothing else: it is not an
# app host and gets no session): one host for every port, so the port comes from the host's own cookie
# (__Host-bn_preview), which the portal sets at /.bn/preview-callback — a single-use, 60-second token the code host's
# /.bn/preview minted for its unlock (answered before the check: the browser has no cookie yet). Then, like the local
# preview site: the portal's check (the cookie, its unlock's 12 hours, Sign out, a new password, the Tailscale login;
# no Origin but the preview's own) names the port, and preview_upstream carries the request to bn-preview. The Code
# page and the portal of the remote site may frame it ({args[0]}).
(remote_preview) {
	@bn_preview_callback path /.bn/preview-callback
	reverse_proxy @bn_preview_callback portal:8000 {
		rewrite /auth/preview-callback?{query}
	}
	# no service worker here: this one origin serves every port and every later unlock, so a worker the sandbox installed
	# would go on answering for other ports and after Sign out, and would see the hand-off's /.bn/preview-callback?t=…
	# (the browser fetches a worker's script with Service-Worker: script; refused, it is not installed). This computer's
	# previews keep them: an origin per port and unlock.
	@bn_preview_sw header Service-Worker script
	header @bn_preview_sw X-Bn-Refused "remote preview: no service workers"
	respond @bn_preview_sw "no service workers on the remote preview host: develop a PWA's worker on this computer's preview (docs/remote.md)" 403
	# (only the portal's answer below may name the port: client copies go first, in a step of their own)
	request_header -X-Bn-Preview-*
	forward_auth portal:8000 {
		uri /auth/verify?app=preview
		copy_headers X-Bn-Preview-Port
	}
	reverse_proxy terminal-upstream:7682 {
		import preview_upstream "{args[0]}" "https://{$REMOTE_PREVIEW_HOST:preview.remote.invalid}"
	}
}

# Bedrock speech-to-text (lib/stt.sh): Open WebUI (and the portal's health check) reach the stt container only
# through this site, so stt itself shares no network with Open WebUI — which trusts X-Portal-User from any peer —
# or the portal: a one-way hop. Port 8090 is not published (compose.yaml publishes 8080 only); it answers on
# Caddy's container networks. Nothing that only Caddy, the portal or the sidecar may set is passed on, and no
# portal secret is added (unlike local_request). Two paths only; recordings are limited to 26 MB here too.
http://:8090 {
	route {
		request_header -X-Portal-User
		request_header -X-Portal-Remote
		request_header -X-Portal-Proxy
		request_header -Tailscale-User-Login
		request_header -Tailscale-User-Name
		request_header -Tailscale-User-Profile-Pic
		request_header -Tailscale-Headers-Info
		request_header -Cookie
		request_body {
			max_size 26MB
		}
		@stt path /v1/audio/transcriptions /healthz
		reverse_proxy @stt stt:8000
		respond 404
	}
}

# Any other Host (a typo, or a DNS-rebinding page pointing its own name at 127.0.0.1) gets nothing.
http:// {
	respond /caddy-health 200
	respond "unknown host" 404
}

# The browser terminal: terminal-off.caddy (nothing; the default) or terminal-on.caddy (compose.terminal.yaml).
import terminal-{$TERMINAL_MODE:off}.caddy

# The Code page: code-off.caddy (nothing; the default) or code-on.caddy (compose.code.yaml).
import code-{$CODE_MODE:off}.caddy

# The Code page's previews: preview-off.caddy (nothing; the default) or preview-on.caddy (compose.code.yaml). The remote
# preview host is remote-*.caddy's (remote_preview above).
import preview-{$PREVIEW_MODE:off}.caddy

# Its sandboxed artifact viewer (HTML files, diagrams, notebooks' HTML outputs), with the previews: artifact-off.caddy
# or artifact-on.caddy. Local only.
import artifact-{$PREVIEW_MODE:off}.caddy

# Remote access: remote-off.caddy (nothing), remote-tailscale.caddy or remote-domain.caddy.
import remote-{$REMOTE_MODE}.caddy
