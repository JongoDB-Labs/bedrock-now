# bedrock-now reverse proxy: one login (the portal) in front of every browser UI.
# Values come from the environment ({$VAR}, set in compose.yaml from .env) — nothing secret lives here.
#   {$PORTAL_HOST}         portal: login + Home          (default bedrock-now.localhost)
#   chat.{$PORTAL_HOST}    Open WebUI                    (logged in via the trusted X-Portal-User header)
#   admin.{$PORTAL_HOST}   LiteLLM admin UI
#   files.{$PORTAL_HOST}   RustFS console                (Host passed through unchanged: the console signs S3 requests with it)
# Every host first deletes any client-supplied X-Portal-User, then asks the portal (forward_auth) whether the
# bn_session cookie is valid; only the portal's answer can set X-Portal-User. Directives inside `route` run in
# the order written (outside it, Caddy would run request_header AFTER forward_auth).
# The three apps may be framed by the portal ({$PORTAL_ORIGIN}, e.g. http://bedrock-now.localhost:8800) and
# nothing else; the portal itself refuses all framing (its own CSP: frame-ancestors 'none').
{
	admin off
	auto_https off
	persist_config off
	# Unprivileged listener inside the container; compose publishes it on 127.0.0.1:${PORTAL_PORT}.
	http_port 8080
}

(portal_auth) {
	forward_auth portal:8000 {
		uri /auth/verify
		copy_headers X-Portal-User
	}
}

# The portal's session cookie (Domain={$PORTAL_HOST}) is never handed to the apps behind it.
(drop_session_cookie) {
	header_up Cookie "bn_session=[^;]*;?\s*" ""
}

# Replaces whatever framing policy the app sends (LiteLLM: X-Frame-Options DENY + CSP frame-ancestors 'none';
# Open WebUI and RustFS: none) with "only the portal may frame this".
(frame_by_portal_only) {
	header_down -X-Frame-Options
	header_down Content-Security-Policy "frame-ancestors {$PORTAL_ORIGIN}"
}

http://{$PORTAL_HOST} {
	route {
		request_header -X-Portal-User
		# Only a remote-access site block (not part of this file yet) may mark a request as remote; a client never can.
		request_header -X-Portal-Remote
		# Caddy's own check endpoint is internal; browsers never need it.
		respond /auth/verify 404
		# The login form is a password and a next= URL; a larger body is refused before it reaches the portal.
		request_body /login {
			max_size 16KB
		}
		# One-click Update/Rollback/Clean: a tiny JSON body (action + password).
		request_body /api/admin/* {
			max_size 4KB
		}
		# The login page and what it needs are public; everything else requires a session. So are the web app
		# manifest, its home-screen icons and the service worker: browsers fetch them without the cookie.
		@public path /login /healthz /favicon.svg /static/login.css /static/logo.svg /manifest.webmanifest /sw.js /icons/app-*
		reverse_proxy @public portal:8000
		import portal_auth
		reverse_proxy portal:8000
	}
}

http://chat.{$PORTAL_HOST} {
	route {
		request_header -X-Portal-User
		import portal_auth
		reverse_proxy open-webui:8080 {
			import drop_session_cookie
			import frame_by_portal_only
		}
	}
}

http://admin.{$PORTAL_HOST} {
	route {
		request_header -X-Portal-User
		import portal_auth
		reverse_proxy litellm:4000 {
			import drop_session_cookie
			# LiteLLM's CSP holds nothing but frame-ancestors 'none', so replacing it loses nothing else.
			import frame_by_portal_only
		}
	}
}

http://files.{$PORTAL_HOST} {
	route {
		request_header -X-Portal-User
		import portal_auth
		reverse_proxy rustfs:9001 {
			import drop_session_cookie
			import frame_by_portal_only
		}
	}
}

# Any other Host (a typo, or a DNS-rebinding page pointing its own name at 127.0.0.1) gets nothing.
http:// {
	respond /caddy-health 200
	respond "unknown host" 404
}
