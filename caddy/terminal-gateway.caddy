# The browser terminal's gateway (compose.terminal.yaml, service terminal-gateway): a second, minimal Caddy and the
# terminal container's only peer, so the main Caddy — its portal login, its speech-to-text site — shares no network
# with the sandbox. Not published on the host; no admin API.
{
	admin off
	auto_https off
	persist_config off
	# No request headers in its log: a failed request to ttyd would otherwise write the secret header down.
	log default {
		format filter {
			wrap json
			fields {
				request>headers delete
			}
		}
	}
}

# On the internal "terminal" network alone ("gateway"): exactly what Claude Code and the terminal's claude-bedrock
# use — LiteLLM's Anthropic API (/v1/messages, …/count_tokens), its model list, the key's own info and model prices,
# its liveness — and shared-mcp's /mcp. Each still needs the terminal's key or SHARED_MCP_TOKEN (and the key itself
# may call only these LiteLLM paths: lib/terminal.sh, TERMINAL_KEY_ROUTES). Everything else (LiteLLM's admin UI and
# API, /key/generate, the /bedrock/… pass-through that signs with the stack's AWS credentials) is 404 here.
http://:8091 {
	bind gateway
	route {
		# Caddy matches paths cleaned but forwards them as sent: a . or .. segment or an empty one (also
		# %-encoded: this is the decoded path) could pass a matcher below and reach another LiteLLM route.
		@unclean vars_regexp {http.request.uri.path} `(^|/)\.\.?(/|$)|//`
		respond @unclean 404
		request_header -X-Portal-User
		request_header -X-Portal-Remote
		request_header -X-Portal-Proxy
		request_header -Tailscale-User-Login
		request_header -Tailscale-User-Name
		request_header -Tailscale-User-Profile-Pic
		request_header -Tailscale-Headers-Info
		request_header -Cookie
		# shared-mcp's DNS-rebinding guard accepts only a loopback Host (shared-mcp/shared_mcp/server.py): no browser
		# reaches this listener, so the gateway names it so.
		@mcp path /mcp /mcp/*
		reverse_proxy @mcp shared-mcp:8000 {
			header_up Host 127.0.0.1:8000
		}
		@litellm path /v1/messages /v1/messages/count_tokens /v1/models /v1/models/* /key/info /model/info /health/liveliness
		reverse_proxy @litellm litellm:4000
		respond 404
	}
}

# On "terminal-link" alone ("terminal-upstream"), for the main Caddy: ttyd, on its UNIX socket (it has no TCP
# listener). The main Caddy has asked the portal (session, fresh unlock, Origin) and adds the terminal's secret
# header; without it — or without a real secret in this container's environment — ttyd is not asked at all. The
# header goes before ttyd: neither ttyd nor anything in the sandbox ever sees the secret. (In a route: outside one,
# Caddy would run handle before respond.)
http://:7681 {
	bind terminal-upstream
	route {
		@weak expression `!'{$TERMINAL_PROXY_SECRET}'.matches('^[0-9a-f]+$') || '{$TERMINAL_PROXY_SECRET}'.size() < 32`
		respond @weak "no TERMINAL_PROXY_SECRET: ./stack terminal enable" 503
		@proxied header X-Bn-Terminal-0{$TERMINAL_PROXY_SECRET} 1
		handle @proxied {
			request_header -X-Bn-Terminal-*
			reverse_proxy unix//run/bn-ttyd/ttyd.sock
		}
		respond 407
	}
}

# The container's health check (its own loopback only).
http://127.0.0.1:8092 {
	bind 127.0.0.1
	respond /health 200
	respond 404
}
